---
import Base from "./Base.astro";
import PostContents from "../components/research/PostContents.astro";
import PostHero, { type PostLink } from "../components/research/PostHero.astro";
import type { MarkdownHeading } from "astro";

interface Props {
  title: string;
  description: string;
  date?: Date;
  updated?: Date;
  author: string;
  tag?: string;
  toc?: boolean;
  headings?: MarkdownHeading[];
  hero?: boolean;
  links?: PostLink[];
  figure?: { src: string; alt: string; caption?: string };
  metaTitle?: string;
  metaDescription?: string;
}

const {
  title,
  description,
  date,
  updated,
  author,
  toc = true,
  headings = [],
  hero = false,
  links = [],
  figure,
  metaTitle,
  metaDescription,
} = Astro.props;
const sections = toc ? headings.filter((h) => h.depth === 2) : [];
const post = { title, description, date, updated, author, links, figure };
---

<Base title={metaTitle ?? `${title} · Pereste`} description={metaDescription ?? description} type="article">
  <article class="relative">
    <div
      class="absolute inset-x-0 top-0 -z-10 h-[40rem]"
      style="background: radial-gradient(70% 55% at 50% 0%, #E6F4F6 0%, rgba(230,244,246,0) 65%);"
      aria-hidden="true"
    >
    </div>

    <div class="container-page pt-24 pb-24 md:pt-32">
      <div class="post-with-contents post-wide">
        {sections.length >= 3 && <PostContents headings={sections} top={false} />}
        <div class="prose-page mx-auto">
          {!hero && <PostHero post={post} headings={sections} />}
          <slot />
        </div>
      </div>
      <div class="hairline post-measure mx-auto mt-16 pt-8">
        <a href="/research" class="link-arrow">All research</a>
      </div>
    </div>
  </article>
</Base>
