---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { socialCardFor } from "../data/social";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  type?: "website" | "article";
}

const {
  title = "Pereste Health",
  description = "Pereste Health builds Pereste Guide, a voice app in development that explains a patient's own health record in plain language for rural chronic care, and publishes safety research on the AI models used in healthcare.",
  canonical,
  type = "website",
} = Astro.props;

const siteUrl = "https://pereste.com";
const canonicalHref = canonical ?? new URL(Astro.url.pathname, siteUrl).toString();
const card = socialCardFor(Astro.url.pathname);
const cardTitle = card?.title ?? title;
const cardDescription = card?.description ?? description;
const cardImage = card ? new URL(card.image, siteUrl).toString() : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FFFFFF" />
    <link rel="canonical" href={canonicalHref} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {/* Marks the document as script-capable before first paint, so reveal
        styles only hide content when the observer that shows it will run. */}
    <script is:inline>document.documentElement.classList.add("js");</script>

    {/* Brand typeface — Montserrat (per Pereste Health brand guidelines) */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=DM+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    {/* Open Graph */}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Pereste" />
    <meta property="og:title" content={cardTitle} />
    <meta property="og:description" content={cardDescription} />
    <meta property="og:url" content={canonicalHref} />
    {card && cardImage && (
      <>
        <meta property="og:image" content={cardImage} />
        <meta property="og:image:type" content="image/jpeg" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={card.alt} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={cardTitle} />
        <meta name="twitter:description" content={cardDescription} />
        <meta name="twitter:image" content={cardImage} />
        <meta name="twitter:image:alt" content={card.alt} />
      </>
    )}

    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <script>
      const targets = document.querySelectorAll<HTMLElement>("[data-reveal]");

      // Once revealed, drop the reveal hooks so the element's own transitions
      // (card hover, press feedback) are no longer overridden.
      const reveal = (el: HTMLElement) => {
        el.setAttribute("data-visible", "");
        const cleanup = () => {
          el.removeAttribute("data-reveal");
          el.removeAttribute("data-visible");
          el.style.removeProperty("--reveal-delay");
        };
        const timer = window.setTimeout(cleanup, 1400);
        el.addEventListener(
          "transitionend",
          (event) => {
            if (event.target !== el) return;
            window.clearTimeout(timer);
            cleanup();
          },
          { once: true },
        );
      };

      if (!("IntersectionObserver" in window)) {
        targets.forEach((el) => reveal(el));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              io.unobserve(entry.target);
              reveal(entry.target as HTMLElement);
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.05 },
        );
        targets.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
