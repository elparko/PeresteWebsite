---
import fs from "node:fs";
import path from "node:path";

interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  primaryCta?: { href: string; label: string };
  secondaryCta?: { href: string; label: string };
  /** Optional image rendered to the right of the copy on desktop.
   *  At build time, if the file does not exist in `public/`, a styled
   *  phone-shaped placeholder renders instead so the layout never breaks. */
  image?: { src: string; alt: string };
}

const { eyebrow, title, lede, primaryCta, secondaryCta, image } = Astro.props;

// Build-time check: does the image actually exist?
let imageReady = false;
if (image) {
  const fsPath = path.join(process.cwd(), "public", image.src.replace(/^\//, ""));
  imageReady = fs.existsSync(fsPath);
}

const showRightCol = !!image; // reserve the column whether or not the file is there
---

<section class="relative overflow-hidden">
  {/* Soft brand wash — teal beam fading into a cool horizon */}
  <div class="hero-bg absolute inset-0 -z-10" aria-hidden="true"></div>

  <div class="container-page pt-14 pb-20 md:pt-24 md:pb-28">
    <div class={showRightCol ? "grid lg:grid-cols-12 gap-14 lg:gap-16 items-center" : ""}>
      <div class={showRightCol ? "lg:col-span-7" : ""}>
        {eyebrow && <p class="eyebrow mb-6 hero-in" style="--i:0">{eyebrow}</p>}
        <h1 class={`hero-in ${showRightCol ? "" : "max-w-4xl"}`} style="--i:1">{title}</h1>
        {lede && <p class="lede mt-7 hero-in" style="--i:2">{lede}</p>}

        {(primaryCta || secondaryCta) && (
          <div class="mt-10 flex flex-wrap items-center gap-3 hero-in" style="--i:3">
            {primaryCta && (
              <a href={primaryCta.href} class="btn-primary">{primaryCta.label}</a>
            )}
            {secondaryCta && (
              <a href={secondaryCta.href} class="btn-secondary">{secondaryCta.label}</a>
            )}
          </div>
        )}
      </div>

      {showRightCol && (
        <div class="lg:col-span-5 flex justify-center lg:justify-end">
          <div class="relative w-full max-w-[248px] lg:max-w-[272px] hero-in-device">
            {/* Soft teal beam glow behind the device */}
            <div
              class="absolute -inset-10 -z-10 rounded-[56px] opacity-80 blur-3xl"
              style="background: radial-gradient(58% 58% at 50% 42%, #8CCFDB 0%, rgba(140,207,219,0) 70%);"
              aria-hidden="true"
            ></div>

            {imageReady ? (
              /* App screen presented in a device frame. */
              <div class="device">
                <img
                  src={image!.src}
                  alt={image!.alt}
                  width="720"
                  height="1558"
                  loading="eager"
                  decoding="async"
                  fetchpriority="high"
                />
              </div>
            ) : (
              /* Placeholder — auto-replaced when the real image lands. */
              <div
                class="aspect-[9/19] w-full rounded-[2.75rem] border border-brand-line bg-gradient-to-b from-brand-subtle to-white shadow-[0_20px_60px_-20px_rgba(35,44,84,0.25)] flex items-center justify-center"
                role="img"
                aria-label={image!.alt}
              >
                <div class="flex flex-col items-center gap-3 px-6 text-center">
                  <img
                    src="/logos/pereste-mark.svg"
                    alt=""
                    class="h-12 w-auto opacity-90"
                  />
                  <p class="text-xs uppercase tracking-[0.18em] text-brand-muted">
                    Guide
                  </p>
                </div>
              </div>
            )}
          </div>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .hero-bg {
    background:
      radial-gradient(56% 50% at 14% -6%, rgba(15, 155, 168, 0.2) 0%, rgba(15, 155, 168, 0) 62%),
      radial-gradient(42% 38% at 94% 4%, rgba(63, 81, 143, 0.14) 0%, rgba(63, 81, 143, 0) 62%),
      linear-gradient(180deg, #f6f8fb 0%, #ffffff 100%);
  }
  /* Twin beams, echoing the lighthouse mark. */
  .hero-bg::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(118deg, rgba(15, 155, 168, 0) 22%, rgba(15, 155, 168, 0.07) 34%, rgba(15, 155, 168, 0) 44%),
      linear-gradient(62deg, rgba(15, 155, 168, 0) 30%, rgba(15, 155, 168, 0.05) 40%, rgba(15, 155, 168, 0) 48%);
    mask-image: linear-gradient(180deg, #000 0%, transparent 85%);
    -webkit-mask-image: linear-gradient(180deg, #000 0%, transparent 85%);
  }
</style>
