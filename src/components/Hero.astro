---
import fs from "node:fs";
import path from "node:path";

interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  primaryCta?: { href: string; label: string };
  secondaryCta?: { href: string; label: string };
  /** Optional image rendered to the right of the copy on desktop.
   *  At build time, if the file does not exist in `public/`, a styled
   *  phone-shaped placeholder renders instead so the layout never breaks. */
  image?: { src: string; alt: string };
}

const { eyebrow, title, lede, primaryCta, secondaryCta, image } = Astro.props;

// Build-time check: does the image actually exist?
let imageReady = false;
if (image) {
  const fsPath = path.join(process.cwd(), "public", image.src.replace(/^\//, ""));
  imageReady = fs.existsSync(fsPath);
}

const showRightCol = !!image; // reserve the column whether or not the file is there
---

<section class="relative overflow-hidden">
  {/* Soft brand wash — teal beam fading into a cool gray horizon */}
  <div
    class="absolute inset-0 -z-10"
    style="background: radial-gradient(70% 55% at 25% 0%, #E6F4F6 0%, rgba(230,244,246,0) 65%), radial-gradient(55% 45% at 100% 12%, #EDF1F7 0%, rgba(237,241,247,0) 70%);"
    aria-hidden="true"
  ></div>

  <div class="container-page pt-12 pb-16 md:pt-20 md:pb-24">
    <div class={showRightCol ? "grid lg:grid-cols-12 gap-12 lg:gap-16 items-center" : ""}>
      <div class={showRightCol ? "lg:col-span-7" : ""}>
        {eyebrow && <p class="eyebrow mb-6">{eyebrow}</p>}
        <h1 class={`tracking-tight-3 ${showRightCol ? "" : "max-w-4xl"}`}>{title}</h1>
        {lede && <p class="lede mt-6">{lede}</p>}

        {(primaryCta || secondaryCta) && (
          <div class="mt-10 flex flex-wrap items-center gap-3">
            {primaryCta && (
              <a href={primaryCta.href} class="btn-primary">{primaryCta.label}</a>
            )}
            {secondaryCta && (
              <a href={secondaryCta.href} class="btn-secondary">{secondaryCta.label}</a>
            )}
          </div>
        )}
      </div>

      {showRightCol && (
        <div class="lg:col-span-5 flex justify-center lg:justify-end">
          <div class="relative w-full max-w-[244px] lg:max-w-[268px]">
            {/* Soft teal beam glow behind the device */}
            <div
              class="absolute -inset-8 -z-10 rounded-[48px] opacity-70 blur-3xl"
              style="background: radial-gradient(58% 58% at 50% 42%, #8CCFDB 0%, rgba(140,207,219,0) 70%);"
              aria-hidden="true"
            ></div>

            {imageReady ? (
              /* Clean app screen presented in a simple device frame. */
              <div class="rounded-[2.6rem] border border-brand-line bg-white p-2 shadow-[0_34px_80px_-30px_rgba(35,44,84,0.45)]">
                <img
                  src={image!.src}
                  alt={image!.alt}
                  class="w-full h-auto rounded-[2.1rem]"
                  loading="eager"
                  decoding="async"
                />
              </div>
            ) : (
              /* Placeholder — auto-replaced when the real image lands. */
              <div
                class="aspect-[9/19] w-full rounded-[2.6rem] border border-brand-line bg-gradient-to-b from-brand-subtle to-white shadow-[0_20px_60px_-20px_rgba(35,44,84,0.25)] flex items-center justify-center"
                role="img"
                aria-label={image!.alt}
              >
                <div class="flex flex-col items-center gap-3 px-6 text-center">
                  <img
                    src="/logos/pereste-mark.svg"
                    alt=""
                    class="h-12 w-auto opacity-90"
                  />
                  <p class="text-xs uppercase tracking-[0.18em] text-brand-muted">
                    Guide
                  </p>
                </div>
              </div>
            )}
          </div>
        </div>
      )}
    </div>
  </div>
</section>
