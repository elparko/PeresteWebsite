---
import fs from "node:fs";
import path from "node:path";

interface Props {
  eyebrow?: string;
  title: string;
  href?: string;
  /** Optional icon shown above the title. Build-time fs check decides
   *  whether the real icon renders or a placeholder takes its place. */
  icon?: { src: string; alt?: string };
  class?: string;
  style?: string;
  "data-reveal"?: boolean | string;
}

const { eyebrow, title, href, icon, class: className = "", ...rest } = Astro.props;
const Tag = href ? "a" : "div";

let iconReady = false;
if (icon) {
  const fsPath = path.join(process.cwd(), "public", icon.src.replace(/^\//, ""));
  iconReady = fs.existsSync(fsPath);
}
---

<Tag href={href} class={`card block p-7 md:p-8 ${className}`} {...rest}>
  {icon && (
    <div class="mb-6">
      {iconReady ? (
        <span class="icon-tile">
          <img
            src={icon.src}
            alt={icon.alt ?? ""}
            class="h-6 w-6"
            loading="lazy"
            decoding="async"
          />
        </span>
      ) : (
        /* Icon placeholder — auto-replaced when the real asset lands. */
        <span class="icon-tile" aria-hidden="true" title="Icon lands here">
          <span class="text-[10px] uppercase tracking-[0.14em] text-brand-muted/80">+</span>
        </span>
      )}
    </div>
  )}
  {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
  <h3 class="font-display mb-3">{title}</h3>
  <div class="text-brand-ink/75 leading-relaxed">
    <slot />
  </div>
  {href && (
    <span class="link-arrow mt-5">Learn more</span>
  )}
</Tag>
