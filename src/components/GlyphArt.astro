---
interface Props {
  piece: "open-capsule" | "headland" | "name-field" | "dosegate" | "dose-steps" | "atlas-units" | "atlas-kinds" | "advice-reply" | "advice-seam" | "dose-probe" | "looped-passes" | "cue-shift" | "danger-control";
  label: string;
  options?: Record<string, unknown>;
  narrow?: Record<string, unknown>;
  pointer?: string;
  ground?: boolean;
  still?: string;
  class?: string;
}
const { piece, label, options = {}, narrow, pointer, ground = true, still, class: className } = Astro.props;
---

<div
  class:list={["glyph-art", className]}
  role={label ? "img" : undefined}
  aria-label={label || undefined}
  aria-hidden={label ? undefined : "true"}
  data-glyph={piece}
  data-glyph-options={JSON.stringify(options)}
  data-glyph-narrow={narrow ? JSON.stringify(narrow) : undefined}
  data-glyph-pointer={pointer}
  data-glyph-ground={ground ? "1" : "0"}
>
  {still && (
    <noscript>
      <img src={still} alt="" class="glyph-still" />
    </noscript>
  )}
</div>

<script>
  const loaders: Record<string, () => Promise<any>> = {
    "open-capsule": () => import("../scripts/glyph/open-capsule.js"),
    headland: () => import("../scripts/glyph/headland.js"),
    "name-field": () => import("../scripts/glyph/name-field.js"),
    dosegate: () => import("../scripts/glyph/dosegate.js"),
    "dose-steps": () => import("../scripts/glyph/dose-steps.js"),
    "atlas-units": () => import("../scripts/glyph/atlas-units.js"),
    "atlas-kinds": () => import("../scripts/glyph/atlas-kinds.js"),
    "advice-reply": () => import("../scripts/glyph/advice-reply.js"),
    "advice-seam": () => import("../scripts/glyph/advice-seam.js"),
    "dose-probe": () => import("../scripts/glyph/dose-probe.js"),
    "looped-passes": () => import("../scripts/glyph/looped-passes.js"),
    "cue-shift": () => import("../scripts/glyph/cue-shift.js"),
    "danger-control": () => import("../scripts/glyph/danger-control.js"),
  };
  for (const el of document.querySelectorAll<HTMLElement>("[data-glyph]")) {
    const load = loaders[el.dataset.glyph ?? ""];
    if (!load) continue;
    const start = async () => {
      const m = await load();
      const options = JSON.parse(el.dataset.glyphOptions || "{}");
      if (el.dataset.glyphNarrow && matchMedia("(max-width: 639px)").matches) Object.assign(options, JSON.parse(el.dataset.glyphNarrow));
      const target = el.dataset.glyphPointer ? el.closest(el.dataset.glyphPointer) : null;
      if (target) options.pointerTarget = target;
      if (el.dataset.glyphGround === "1") el.style.background = m.ground;
      m.mount(el, options);
    };
    start().catch(() => {});
  }
</script>

<style>
  .glyph-art {
    position: relative;
    width: 100%;
    overflow: hidden;
  }
  .glyph-still {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>
