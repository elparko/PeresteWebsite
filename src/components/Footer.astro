---
const year = new Date().getFullYear();
const cols = [
  {
    heading: "Company",
    links: [
      { href: "/about", label: "About" },
      { href: "/research", label: "Research" },
      { href: "/careers", label: "Careers" },
      { href: "/press", label: "Press" },
    ],
  },
  {
    heading: "Product",
    links: [
      { href: "/guide", label: "Guide" },
    ],
  },
  {
    heading: "Legal",
    links: [
      { href: "/privacy", label: "Privacy Policy" },
      { href: "/terms", label: "Terms of Service" },
      { href: "/oss", label: "Open-Source Notices" },
    ],
  },
  {
    heading: "Contact",
    links: [
      { href: "mailto:parker@pereste.com", label: "General inquiries" },
      { href: "mailto:parker@pereste.com", label: "Press" },
      { href: "mailto:parker@pereste.com", label: "Partnerships" },
    ],
  },
];
---

<footer class="hairline mt-28">
  <div class="container-page py-14">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-5">
      <div>
        <a href="/" class="inline-flex items-center gap-3" aria-label="Pereste Health home">
          <img
            src="/logos/pereste-mark.svg"
            alt=""
            width="40"
            height="42"
            class="h-11 w-auto"
            loading="lazy"
            decoding="async"
          />
          <span class="leading-none">
            <span class="block font-display text-xl font-semibold tracking-[0.18em] uppercase text-brand-indigo">Pereste</span>
            <span class="mt-1 block font-display text-[0.68rem] font-medium tracking-[0.3em] uppercase text-brand-accent">Health</span>
          </span>
        </a>
        <p class="mt-5 text-sm text-brand-muted max-w-xs leading-relaxed">
          Better understanding, better outcomes.
        </p>
      </div>

      {cols.map((col) => (
        <div>
          <h4 class="text-xs uppercase tracking-[0.18em] text-brand-muted font-medium">
            {col.heading}
          </h4>
          <ul class="mt-4 space-y-2">
            {col.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="footer-link text-sm text-brand-ink"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="hairline mt-12 pt-6 flex flex-col md:flex-row items-start md:items-center justify-between gap-3">
      <p class="text-xs text-brand-muted">
        © {year} Pereste Health Inc. Based in Louisiana, USA.
      </p>
      <p class="text-xs text-brand-muted">
        Pereste is a healthcare AI company. Information on this site is not medical advice.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer-link {
    transition: color var(--dur-hover) ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .footer-link:hover {
      color: theme("colors.brand.accent");
    }
  }
</style>
