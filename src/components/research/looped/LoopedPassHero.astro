---
import data from "../../../data/research/looped-model-dose-errors/pass-scores.json";

const { about, ...payload } = data;
const summary = "Three stacked planes stand for Pass 1, 2 and 3 of the same shared middle layers (6 to 17) of Inkling 2 Mini. Each dot is one question, placed left to right by the internal probe's risk score after that pass, terracotta when the final answer was wrong. Only Pass 3 feeds the output layers, which pick the first token: a bare space before a dose, or AV for AVOID. On the 64 anticoagulant questions whose label says avoid, the probe scores 0.299, 0.473 and 0.947 across the passes. On the 1,940 questions where the model should dose and did, it scores 0.675, 0.664 and 0.692.";
---

<figure class="lp" data-lp>
  <div class="lp-controls" role="group" aria-label="Which questions">
    <button type="button" class="lp-btn" data-set="anticoag_avoid" aria-pressed="true">anticoagulants, label says avoid</button>
    <button type="button" class="lp-btn" data-set="numeric" aria-pressed="false">numeric doses only</button>
  </div>
  <div class="lp-stage">
    <canvas class="lp-canvas" role="img" aria-label={summary}></canvas>
  </div>
  <p class="lp-line" aria-live="polite"></p>
  <p class="lp-foot">Each plane is one pass through the shared layers 6 to 17 of Inkling 2 Mini; the number beside it is the probe's score after that pass. Dot positions are the real probe scores, as ranks within each set of questions, from probes tested on drug classes held out of training.</p>
  <script type="application/json" data-lp-data set:html={JSON.stringify(payload)} />
</figure>

<style is:global>
  .lp { --bg: #ffffff; --ink: #232c54; --indigo: #3f518f; --muted: #5a6472; --danger: #b4532a; --teal: #0f9ba8; --pale: #8ccfdb; --font: "Montserrat", ui-sans-serif, system-ui, sans-serif; --mono: "DM Mono", ui-monospace, "SF Mono", Menlo, monospace; margin: 0; }
  .lp-controls { display: flex; flex-wrap: wrap; gap: 0.15rem 1rem; margin-bottom: 0.4rem; }
  .lp .lp-btn { font: 500 11px/1.2 var(--font); letter-spacing: 0.02em; color: var(--ink); background: none; border: 0; padding: 4px 1px; cursor: pointer; text-decoration: underline dotted; text-underline-offset: 4px; text-decoration-color: var(--muted); }
  .lp .lp-btn[aria-pressed="true"] { font-weight: 600; text-decoration-style: solid; text-decoration-color: currentColor; }
  .lp .lp-btn:focus-visible { outline: 1.5px solid var(--ink); outline-offset: 2px; border-radius: 3px; }
  .lp-stage { position: relative; touch-action: pan-y; -webkit-user-select: none; user-select: none; }
  .lp-canvas { display: block; width: 100%; cursor: default; }
  .prose-page .lp .lp-line, .lp .lp-line { margin: 0.5rem 0 0; font-size: 0.85rem; line-height: 1.5; color: var(--muted); min-height: 4.5em; }
  .lp .lp-line strong { color: var(--ink); font-weight: 600; font-variant-numeric: tabular-nums; }
  .prose-page .lp .lp-foot, .lp .lp-foot { margin: 0.4rem 0 0; font-size: 0.72rem; line-height: 1.4; color: var(--muted); }
</style>

<script>
  // @ts-nocheck
  document.querySelectorAll("[data-lp]").forEach((fig) => {

const D = JSON.parse(fig.querySelector("[data-lp-data]").textContent);
const stage = fig.querySelector(".lp-stage"), canvas = fig.querySelector(".lp-canvas"), ctx = canvas.getContext("2d");
const line = fig.querySelector(".lp-line"), btns = [...fig.querySelectorAll("[data-set]")];
const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
const LINES = {
  anticoag_avoid: "Each dot is one of the 64 anticoagulant questions whose label says avoid; the <strong>35</strong> terracotta dots are the ones where the model gave a dose anyway. After Pass 1 the probe ranks them backwards (<strong>0.299</strong>), after Pass 2 it scores <strong>0.473</strong>, and after Pass 3 <strong>0.947</strong>. Pass 3 is the only pass that feeds the output layers, where the model commits to a bare space or to AV.",
  numeric: "Each dot is one of the 1,940 questions where the model should give a dose and did; the <strong>463</strong> terracotta dots are wrong doses. Here the three passes score <strong>0.675</strong>, <strong>0.664</strong> and <strong>0.692</strong>, a Pass 3 gain of only <strong>+0.017</strong> (p = 0.653).",
};
const EXIT = { anticoag_avoid: [35, 29], numeric: [1940, 0] };
const DEEP = 0.26, TILT = 0.34, YAW0 = -0.28, CYCLE = 7.5;
let set = "anticoag_avoid", fade = 1, prev = null;
let W = 0, H = 0, dpr = 1, phone = false, cx = 0, scale = 1, yP = [0, 0, 0], yExit = 0, tile = {};
let yaw = YAW0, yawTo = YAW0, sway = 0, co = 1, si = 0, drag = false, lastX = 0, inside = false, clock = 0;
const col = {}, drops = [];

const hash = (i, k) => { const h = Math.sin(i * 12.9898 + k * 78.233) * 43758.5453; return h - Math.floor(h); };
function build(name) {
  const s = D[name], n = s.y.length;
  return s.y.map((y, i) => ({ y, z: (hash(i, name.length) * 2 - 1) * DEEP * 0.82, r: [s.p1[i], s.p2[i], s.p3[i]] }));
}
const sets = { anticoag_avoid: build("anticoag_avoid"), numeric: build("numeric") };

const css = (n) => getComputedStyle(fig).getPropertyValue(n).trim();
const rgba = (hex, a) => { const v = parseInt(hex.slice(1), 16); return `rgba(${v >> 16},${(v >> 8) & 255},${v & 255},${a})`; };
const clamp = (v, a, b) => (v < a ? a : v > b ? b : v);
const sm = (t) => { t = clamp(t, 0, 1); return t * t * (3 - 2 * t); };
const PX = (x, z) => cx + (x * co - z * si) * scale, PY = (k, x, z) => yP[k] + (x * si + z * co) * scale * TILT;
const xOf = (r) => -0.94 + 1.88 * r;

function layout() {
  W = stage.clientWidth; phone = W < 520;
  const left = phone ? 50 : 64, right = phone ? 44 : 56;
  cx = left + (W - left - right) / 2; scale = (W - left - right) / 2 / 1.08;
  const half = (Math.sin(0.6) + DEEP) * scale * TILT, gap = Math.max(2 * half * 0.78, phone ? 58 : 74);
  yP = [22 + half, 22 + half + gap, 22 + half + 2 * gap];
  yExit = yP[2] + half + (phone ? 46 : 54);
  tile = { h: phone ? 22 : 24, y: yExit + 12 };
  H = Math.round(tile.y + tile.h + 52);
  dpr = Math.min(2.5, window.devicePixelRatio || 1);
  canvas.width = Math.round(W * dpr); canvas.height = Math.round(H * dpr); canvas.style.height = H + "px";
  draw();
}

function plane(k, glow) {
  ctx.beginPath();
  [[-1, -DEEP], [1, -DEEP], [1, DEEP], [-1, DEEP]].forEach(([x, z], i) => (i ? ctx.lineTo(PX(x, z), PY(k, x, z)) : ctx.moveTo(PX(x, z), PY(k, x, z))));
  ctx.closePath();
  ctx.fillStyle = rgba(col.teal, 0.035 + 0.06 * glow); ctx.fill();
  ctx.strokeStyle = rgba(col.ink, 0.22 + 0.25 * glow); ctx.lineWidth = 0.8; ctx.stroke();
}
function endpoint(x, side, on) {
  const mono = css("--mono"), font = css("--font"), y = tile.y, h = tile.h, fs = phone ? 12 : 13;
  ctx.globalAlpha = on ? 1 : 0.35;
  ctx.textBaseline = "middle";
  // the reply as written, with its first token boxed
  ctx.font = `500 ${fs}px ${mono}`;
  const cw = ctx.measureText("0").width;
  const first = side.first, rest = side.rest, wFirst = Math.max(first.length, 1) * cw + 10, wRest = rest.length * cw;
  const x0 = x - (wFirst + 4 + wRest) / 2;
  ctx.fillStyle = side.box; ctx.fillRect(x0, y, wFirst, h);
  ctx.textAlign = "left"; ctx.fillStyle = side.boxInk;
  if (first) ctx.fillText(first, x0 + 5, y + h / 2 + 0.5);
  else { ctx.fillStyle = rgba(side.boxInk === col.ink ? col.ink : "#e6f4f6", 0.7); ctx.fillRect(x0 + 5, y + h - 7, wFirst - 10, 1.2); }
  ctx.fillStyle = rgba(col.ink, 0.55); ctx.fillText(rest, x0 + wFirst + 4, y + h / 2 + 0.5);
  // what it means, and how many answers ended here
  ctx.textAlign = "center"; ctx.textBaseline = "alphabetic";
  ctx.font = `600 11px ${font}`; ctx.fillStyle = col.ink; ctx.fillText(side.title, x, y + h + 16);
  ctx.font = `500 10.5px ${font}`; ctx.fillStyle = side.tone; ctx.fillText(side.count, x, y + h + 30);
  ctx.font = `400 9.5px ${font}`; ctx.fillStyle = col.muted; ctx.fillText(side.note, x, y + h + 43);
  ctx.globalAlpha = 1;
}

function dotsFor(list, alpha, big) {
  const r = big ? 2.6 : 1.15;
  // threads: each question from one pass to the next
  const step = big ? 1 : 9;
  ctx.lineWidth = big ? 0.7 : 0.5;
  for (let i = 0; i < list.length; i += step) { const q = list[i], c = q.y ? col.danger : col.teal;
    ctx.strokeStyle = rgba(c, (big ? 0.2 : 0.07) * alpha); ctx.beginPath();
    for (let k = 0; k < 3; k++) { const x = xOf(q.r[k]); k ? ctx.lineTo(PX(x, q.z), PY(k, x, q.z)) : ctx.moveTo(PX(x, q.z), PY(k, x, q.z)); }
    ctx.stroke(); }
  for (let k = 0; k < 3; k++) for (const q of list) {
    const x = xOf(q.r[k]);
    ctx.beginPath(); ctx.arc(PX(x, q.z), PY(k, x, q.z), r, 0, 6.2832);
    ctx.fillStyle = rgba(q.y ? col.danger : col.teal, (big ? 0.9 : 0.5) * alpha); ctx.fill();
  }
}

function draw() {
  for (const n of ["bg", "ink", "indigo", "muted", "danger", "teal", "pale"]) col[n] = css("--" + n);
  const font = css("--font");
  co = Math.cos(yaw); si = Math.sin(yaw);
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0); ctx.clearRect(0, 0, W, H);
  const u = still ? 0.9 : (clock % CYCLE) / CYCLE;
  const glow = [0, 1, 2].map((k) => still ? 0 : Math.max(0, 1 - Math.abs(u * 4.2 - k - 0.4) * 1.6));
  const front = co >= 0 ? DEEP : -DEEP;

  for (let k = 0; k < 3; k++) plane(k, glow[k]);

  // the stem: only Pass 3 continues to the output layers
  const sx = PX(0, 0), sTop = PY(2, 0, front) + 2, sBot = yExit - 14;
  ctx.strokeStyle = rgba(col.ink, 0.6); ctx.lineWidth = 1.2; ctx.beginPath(); ctx.moveTo(sx, PY(2, 0, 0)); ctx.lineTo(sx, sBot); ctx.stroke();
  const tx = phone ? Math.min(92, W / 2 - 66) : Math.min(132, W / 2 - 90);
  ctx.beginPath(); ctx.moveTo(sx, sBot); ctx.lineTo(sx - tx, tile.y - 2); ctx.moveTo(sx, sBot); ctx.lineTo(sx + tx, tile.y - 2); ctx.strokeStyle = rgba(col.ink, 0.35); ctx.lineWidth = 0.9; ctx.stroke();
  ctx.font = `500 10.5px ${font}`; ctx.textAlign = "left"; ctx.textBaseline = "middle"; ctx.fillStyle = col.muted;
  ctx.fillText(phone ? "layers 18 to 23" : "layers 18 to 23, then the first token", sx + 8, (sTop + sBot) / 2 + 6);

  if (prev && fade < 1) dotsFor(sets[prev], 1 - fade, prev === "anticoag_avoid");
  dotsFor(sets[set], fade, set === "anticoag_avoid");

  // drops: a few Pass 3 answers fall through the stem to their first token
  for (let i = drops.length - 1; i >= 0; i--) {
    const d = drops[i], t = (clock - d.t0) / 1.6;
    if (t >= 1) { drops.splice(i, 1); continue; }
    const x0 = PX(xOf(d.q.r[2]), d.q.z), y0 = PY(2, xOf(d.q.r[2]), d.q.z), x2 = sx + (d.q.y || set === "numeric" ? tx : -tx);
    let x, y;
    if (t < 0.45) { const a = sm(t / 0.45); x = x0 + (sx - x0) * a; y = y0 + (sBot - y0) * a; }
    else { const a = sm((t - 0.45) / 0.55); x = sx + (x2 - sx) * a; y = sBot + (tile.y + tile.h / 2 - sBot) * a; }
    ctx.beginPath(); ctx.arc(x, y, 2.4, 0, 6.2832); ctx.fillStyle = rgba(d.q.y ? col.danger : col.teal, 1 - Math.max(0, t - 0.85) / 0.15); ctx.fill();
  }

  const [nDose, nAv] = EXIT[set], ac = set === "anticoag_avoid";
  endpoint(sx + tx, {
    first: "", rest: phone ? "5 mg" : "5 mg daily", box: col.indigo, boxInk: "#e6f4f6",
    title: "gives a dose",
    count: ac ? (phone ? "35, all wrong" : "35 missed contraindications") : (phone ? "1,940, 463 wrong" : "1,940 doses, 463 wrong"),
    tone: ac ? col.danger : col.ink,
    note: phone ? "first token: a space" : "first token is a bare space",
  }, nDose > 0);
  endpoint(sx - tx, {
    first: "AV", rest: "OID", box: col.pale, boxInk: col.ink,
    title: "refuses the drug",
    count: ac ? (phone ? "29, all right" : "29 correct refusals") : "none",
    tone: ac ? "#0f8794" : col.muted,
    note: phone ? "first token: AV" : "first token is AV",
  }, nAv > 0);

  // labels: pass names on the left, the probe score on the right
  const sc = D.auroc[set];
  for (let k = 0; k < 3; k++) {
    const y = PY(k, -1, 0);
    ctx.textBaseline = "middle"; ctx.textAlign = "left"; ctx.font = `600 11px ${font}`; ctx.fillStyle = col.ink;
    ctx.fillText("pass " + (k + 1), 2, yP[k]);
    ctx.textAlign = "right"; ctx.font = `600 12px ${font}`;
    ctx.fillText(sc[k].toFixed(3), W - 2, yP[k]);
  }
  ctx.font = `400 10px ${font}`; ctx.fillStyle = col.muted; ctx.textBaseline = "alphabetic";
  ctx.textAlign = "left"; ctx.fillText("looks right", PX(-1, -front) + 2, PY(0, -1, -front) - 7);
  ctx.textAlign = "right"; ctx.fillText("looks wrong", PX(1, -front) - 2, PY(0, 1, -front) - 7);
}

function choose(name) {
  if (name === set) return;
  prev = set; set = name; fade = still ? 1 : 0; drops.length = 0;
  btns.forEach((b) => b.setAttribute("aria-pressed", b.dataset.set === set));
  line.innerHTML = LINES[set];
  if (still) draw();
}
btns.forEach((b) => b.addEventListener("click", () => choose(b.dataset.set)));

const pos = (e) => { const r = canvas.getBoundingClientRect(); return e.clientX - r.left; };

let last = 0, lastPhase = 0;
function frame(now) {
  const dt = Math.min(0.05, last ? (now - last) / 1000 : 0.016); last = now; clock += dt;
  fade = Math.min(1, fade + dt / 0.7);
  const ph = (clock % CYCLE) / CYCLE;
  if (lastPhase < 0.72 && ph >= 0.72) { const list = sets[set], m = set === "numeric" ? 6 : 4;
    for (let i = 0; i < m; i++) drops.push({ q: list[Math.floor(Math.random() * list.length)], t0: clock + i * 0.22 }); }
  lastPhase = ph;
  if (!inside && !drag) sway += dt;
  yaw = YAW0;
  draw();
  if (visible) requestAnimationFrame(frame); else { running = false; last = 0; }
}
let visible = false, running = false;
new ResizeObserver(layout).observe(stage);
line.innerHTML = LINES[set]; layout();
if (document.fonts && document.fonts.ready) document.fonts.ready.then(draw);
new IntersectionObserver((es) => { visible = es.some((e) => e.isIntersecting); if (visible && !running && !still) { running = true; requestAnimationFrame(frame); } }).observe(stage);
  });
</script>
