---
import "../../../styles/research-explainers.css";
import messages from "../../../data/research/medication-danger-and-control/sixty-messages.json";

interface Props {
  title?: string;
}

const { title } = Astro.props;
const mean = (danger: boolean, k: "lean" | "silenced" | "swapped") => (messages.filter((m) => m.danger === danger).reduce((a, m) => a + m[k], 0) / 30).toFixed(2);
const summary = `Sixty messages, 30 dangerous and 30 harmless, each placed at the urgency reading Qwen3.5-4B gives it. Mean reading ${mean(true, "lean")} for dangerous and ${mean(false, "lean")} for harmless messages. With the 200 units that best predict danger silenced: ${mean(true, "silenced")} and ${mean(false, "silenced")}. With the reply position swapped within each pair: ${mean(true, "swapped")} and ${mean(false, "swapped")}.`;
---

<figure class="sm" data-sm>
  {title && <figcaption class="sm-title">{title}</figcaption>}
  <div class="stage"><canvas role="img" aria-label={summary}></canvas></div>
  <p class="msg" aria-live="polite"></p>
  <p class="line"></p>
  <script type="application/json" data-sm-data set:html={JSON.stringify(messages).replace(/</g, "\\u003c")} />
</figure>

<script>

  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const rng = (seed) => () => {
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
  const clamp = (v, a, b) => (v < a ? a : v > b ? b : v);
  const smooth = (t) => { t = clamp(t, 0, 1); return t * t * (3 - 2 * t); };
  const layer = (env) => { const c = document.createElement("canvas"); c.width = env.canvas.width; c.height = env.canvas.height; const g = c.getContext("2d"); g.setTransform(env.dpr, 0, 0, env.dpr, 0, 0); return [c, g]; };
  function stage(sec, piece) {
    const wrap = sec.querySelector(".stage"), canvas = wrap.querySelector("canvas"), ctx = canvas.getContext("2d");
    const env = { sec, wrap, canvas, ctx, W: 0, H: 0, dpr: 1, still, px: -1e4, py: -1e4, inside: false, touch: false, small: false, line: sec.querySelector(".line"), request: () => {}, label: (el, x, y) => { el.style.transform = `translate(${x.toFixed(1)}px, ${y.toFixed(1)}px)`; } };
    let raf = 0, last = 0, visible = false, built = false, seen = false;
    const loop = (now) => { raf = 0; const dt = last ? Math.min(0.05, (now - last) / 1000) : 0.016; last = now; const busy = piece.frame(env, dt); if (busy && visible) raf = requestAnimationFrame(loop); else last = 0; };
    env.request = () => { if (!raf && visible && built) raf = requestAnimationFrame(loop); };
    const size = () => {
      const w = wrap.clientWidth; if (!w) return;
      const h = Math.round(w * (w < 520 ? piece.narrow : piece.wide));
      if (built && w === env.W && h === env.H) return;
      env.W = w; env.H = h; env.dpr = Math.min(2, window.devicePixelRatio || 1); env.small = w < 520;
      wrap.style.height = h + "px"; canvas.width = Math.round(w * env.dpr); canvas.height = Math.round(h * env.dpr); ctx.setTransform(env.dpr, 0, 0, env.dpr, 0, 0);
      piece.build(env); built = true; piece.frame(env, 0);
      if (visible && !seen) { seen = true; if (!still) piece.intro(env); }
      env.request();
    };
    const at = (e) => { const b = canvas.getBoundingClientRect(); env.px = e.clientX - b.left; env.py = e.clientY - b.top; env.touch = e.pointerType === "touch"; };
    wrap.addEventListener("pointermove", (e) => { at(e); env.inside = true; piece.pointer(env, e); env.request(); });
    wrap.addEventListener("pointerdown", (e) => { at(e); env.inside = true; piece.tap(env, e); env.request(); });
    wrap.addEventListener("pointerleave", () => { env.inside = false; env.px = env.py = -1e4; piece.leave(env); env.request(); });
    new IntersectionObserver((es) => { visible = es.some((e) => e.isIntersecting); if (visible && built && !seen) { seen = true; if (!still) piece.intro(env); } env.request(); }, { threshold: 0.15 }).observe(wrap);
    new ResizeObserver(size).observe(wrap);
    size();
    return env;
  }

  const lerp = (a, b, t) => a + (b - a) * t;
  document.querySelectorAll("[data-sm]").forEach((sec) => {
    const MESSAGES = JSON.parse(sec.querySelector("[data-sm-data]").textContent);

  const wrap = sec.querySelector(".stage");
  wrap.style.background = "#151a3a"; wrap.style.cursor = "default"; wrap.tabIndex = 0; wrap.setAttribute("role", "group");
  wrap.setAttribute("aria-label", "Sixty messages placed by the model's urgency reading. Arrow keys move between messages.");
  const mk = (tag, cls, text) => { const e = document.createElement(tag); e.className = cls; if (text != null) e.textContent = text; wrap.appendChild(e); return e; };
  const axis = mk("span", "lab note left sky", "urgency reading");
  const cue = mk("span", "lab note right cue", matchMedia("(hover: none)").matches ? "Tap a message" : "Point at a message");
  const ticks = [0, 2, 4, 6].map((v) => mk("span", "lab tick left sky", String(v)));
  const means = [mk("span", "lab num right", ""), mk("span", "lab num right", "")];
  const caps = [mk("span", "lab note right", "dangerous messages"), mk("span", "lab note right", "harmless messages")];
  const HUE = ["#ff9d7a", "#7fdcf0"]; means.forEach((e, t) => (e.style.color = caps[t].style.color = HUE[t]));
  const unitsLabel = mk("span", "lab note sky", "200 units that best predict danger");
  const unitsCount = mk("span", "lab note", ""); unitsCount.style.color = "#ffe08a";
  const card = sec.querySelector(".msg");
  const order = [...new Set(MESSAGES.map((m) => m.pair))].sort((a, b) => MESSAGES.find((m) => m.pair === b && m.danger).lean - MESSAGES.find((m) => m.pair === a && m.danger).lean);
  const col = {}; order.forEach((p, i) => (col[p] = i));
  const msgs = MESSAGES.map((m, i) => ({ ...m, i, v: m.lean, x: 0, y: 0 }));
  const pr = rng(9), perm = [...Array(200).keys()].sort(() => pr() - 0.5);
  let demo = 2, demoT = 0;
  const act = () => { if (demo === 0) mode = "rest"; demo = 2; cue.classList.add("seen"); };
  let mode = "rest", sel = Math.max(0, msgs.findIndex((m) => m.danger && m.item === "methotrexate")), hover = -1, env0 = null, geo, ground;
  const lit = new Float32Array(200);
  const key = () => (mode === "silence" ? "silenced" : mode === "swap" ? "swapped" : "lean");
  const mean = (t, k) => msgs.filter((m) => m.danger === (t === 0)).reduce((a, m) => a + m[k], 0) / 30;
  const f2 = (v) => (v < 0 ? "−" : "") + Math.abs(v).toFixed(2);
  const LINE = {
    rest: "Each point is one message at Qwen3.5-4B’s urgency reading for it: log-probability of “High” words minus “Low” words. 30 dangerous, 30 harmless.",
    silence: `The 200 units silenced: difference between the two means ${f2(mean(0, "lean") - mean(1, "lean"))} → ${f2(mean(0, "silenced") - mean(1, "silenced"))} (−0.027, 95% interval −0.044 to −0.014).`,
    swap: `Reply position swapped within each pair: difference ${f2(mean(0, "lean") - mean(1, "lean"))} → ${f2(mean(0, "swapped") - mean(1, "swapped"))} (−1.86, 95% interval −2.15 to −1.59). The test can detect a change.`,
  };
  const btn = {};
  for (const [id, text] of [["silence", "silence the 200"], ["swap", "swap the reply position"]]) {
    const b = document.createElement("button"); b.type = "button"; b.className = "lab"; b.textContent = text; b.setAttribute("aria-pressed", "false"); wrap.appendChild(b); btn[id] = b;
    b.addEventListener("click", (e) => { e.stopPropagation(); act(); mode = mode === id ? "rest" : id; show(); });
  }
  function show() {
    for (const id in btn) btn[id].setAttribute("aria-pressed", String(mode === id));
    const m = msgs[hover >= 0 ? hover : sel];
    const extra = mode === "silence" ? ` With the 200 silenced: <strong>${f2(m.silenced)}</strong>.` : mode === "swap" ? ` After the swap with its pair: <strong>${f2(m.swapped)}</strong>.` : "";
    card.innerHTML = `<q>${m.text}</q><span>Urgency reading <strong>${f2(m.lean)}</strong>. <strong>${m.firing}</strong> of the 200 units fire on it.${extra}</span>`;
    card.style.borderColor = HUE[m.danger ? 0 : 1];
    unitsCount.textContent = mode === "silence" ? "all 200 silenced" : `${m.firing} fire on this message`;
    if (env0) { env0.line.textContent = LINE[mode]; env0.request(); }
  }
  const near = (env, reach) => { let best = -1, d = reach * reach; msgs.forEach((m, i) => { const q = (m.x - env.px) ** 2 + (m.y - env.py) ** 2; if (q < d) { d = q; best = i; } }); return best; };

  const piece = {
    wide: 0.62, narrow: 1.45,
    build(env) {
      const { W, H, small } = env; env0 = env;
      const L = 40, T = 30, FR = small ? W - 12 : W * 0.63, FB = small ? H * 0.52 : H - 16;
      const Yv = (v) => lerp(FB, T, (v + 2.6) / 10.4);
      const cols = small ? 25 : 10, rows = 200 / cols, cell = small ? Math.min(12, (W - 40) / cols) : Math.min(13, (H - 150) / rows);
      const ux = small ? (W - cols * cell) / 2 : W * 0.815 - (cols * cell) / 2, uy = small ? H * 0.655 : (H - rows * cell) / 2 - 8;
      geo = { W, H, L, T, FR, FB, Yv, cols, rows, cell, ux, uy };
      const [c, g] = layer(env); ground = c;
      const gr = g.createLinearGradient(0, 0, 0, H); gr.addColorStop(0, "#10142f"); gr.addColorStop(0.55, "#171d44"); gr.addColorStop(1, "#1f2757");
      g.fillStyle = gr; g.fillRect(0, 0, W, H);
      g.strokeStyle = "rgba(190,205,255,0.14)"; g.lineWidth = 1; g.setLineDash([1, 6]); g.lineCap = "round";
      for (const v of [0, 2, 4, 6]) { g.beginPath(); g.moveTo(L, Yv(v)); g.lineTo(FR, Yv(v)); g.stroke(); }
      msgs.forEach((m) => { m.x = L + 10 + ((col[m.pair] + 0.5) / 30) * (FR - L - 20); });
      env.label(axis, 8, 14); env.label(cue, FR - 4, 14); ticks.forEach((t, i) => env.label(t, 14, Yv([0, 2, 4, 6][i])));
      env.label(unitsLabel, ux + (cols * cell) / 2, uy - 16); env.label(unitsCount, ux + (cols * cell) / 2, uy + rows * cell + 15);
      env.label(btn.silence, ux + (cols * cell) / 2, uy + rows * cell + (small ? 44 : 46));
      btn.swap.classList.add("right"); env.label(btn.swap, FR - 4, small ? FB + 20 : FB - 14);
      show();
    },
    frame(env, dt) {
      const { ctx, W, H } = env, { L, FR, Yv, cols, cell, ux, uy } = geo; let busy = false;
      if (demo === 0) {
        demoT += dt; busy = true;
        const ph = demoT < 1.4 ? "rest" : demoT < 4 ? "silence" : demoT < 4.7 ? "rest" : demoT < 7.6 ? "swap" : null;
        if (ph === null) { demo = 2; mode = "rest"; show(); } else if (ph !== mode) { mode = ph; show(); }
      }
      const k = key(), rate = still ? 1 : 1 - Math.exp(-dt * 4.5), cur = msgs[hover >= 0 ? hover : sel];
      const mu = [0, 0];
      for (const m of msgs) { const d = m[k] - m.v; if (Math.abs(d) > 0.002) { m.v += d * rate; busy = true; } else m.v = m[k]; m.y = Yv(m.v); mu[m.danger ? 0 : 1] += m.v / 30; }
      const start = (cur.i * 37) % 200;
      for (let q = 0; q < 200; q++) { const to = mode !== "silence" && q < cur.firing ? 1 : 0, u = perm[(start + q) % 200], d = to - lit[u]; if (Math.abs(d) > 0.01) { lit[u] += d * (still ? 1 : 1 - Math.exp(-dt * 12)); busy = true; } else lit[u] = to; }
      ctx.drawImage(ground, 0, 0, W, H);
      ctx.lineCap = "round";
      for (let t = 0; t < 2; t++) {
        const y = Yv(mu[t]); ctx.strokeStyle = HUE[t]; ctx.globalAlpha = 0.55; ctx.lineWidth = 1; ctx.setLineDash([5, 5]); ctx.beginPath(); ctx.moveTo(L, y); ctx.lineTo(FR, y); ctx.stroke(); ctx.setLineDash([]);
        means[t].textContent = f2(mu[t]); env.label(means[t], FR - 2, y - (W < 520 ? 12 : 15)); env.label(caps[t], FR - 2, y + 11);
      }
      const partner = msgs.find((m) => m.pair === cur.pair && m.danger !== cur.danger);
      ctx.globalAlpha = 0.5; ctx.strokeStyle = "#c9d6ff"; ctx.lineWidth = 1; ctx.beginPath(); ctx.moveTo(cur.x, cur.y); ctx.lineTo(partner.x, partner.y); ctx.stroke();
      const rad = W < 520 ? 3.4 : 4.4;
      for (const m of msgs) {
        const on = m === cur; ctx.globalAlpha = on ? 1 : 0.82; ctx.fillStyle = HUE[m.danger ? 0 : 1];
        ctx.beginPath(); ctx.arc(m.x, m.y, on ? rad + 2.2 : rad, 0, 6.2832); ctx.fill();
        if (on) { ctx.strokeStyle = "#ffffff"; ctx.lineWidth = 1.6; ctx.beginPath(); ctx.arc(m.x, m.y, rad + 5, 0, 6.2832); ctx.stroke(); }
      }
      const off = mode === "silence";
      for (let u = 0; u < 200; u++) {
        const x = ux + ((u % cols) + 0.5) * cell, y = uy + (Math.floor(u / cols) + 0.5) * cell, a = lit[u];
        ctx.globalAlpha = off ? 0.35 : 0.5 + 0.5 * a; ctx.fillStyle = a > 0.02 ? `rgba(255,224,138,${0.25 + 0.75 * a})` : off ? "#3a4270" : "#56608e";
        ctx.beginPath(); ctx.arc(x, y, cell * (0.2 + 0.14 * a), 0, 6.2832); ctx.fill();
      }
      ctx.globalAlpha = 1;
      return busy;
    },
    pointer(env) { if (env.touch) return; const i = near(env, 28); wrap.style.cursor = i >= 0 ? "pointer" : "default"; if (i >= 0) act(); if (i !== hover) { hover = i; show(); } },
    tap(env, e) { if (e.target.closest("button")) return; act(); const i = near(env, env.touch ? 36 : 28); if (i >= 0) { sel = i; hover = -1; show(); } },
    leave() { if (hover !== -1) { hover = -1; show(); } },
    intro() { demo = 0; demoT = 0; },
  };
  stage(sec, piece);
  wrap.addEventListener("keydown", (e) => {
    const d = e.key === "ArrowRight" || e.key === "ArrowDown" ? 1 : e.key === "ArrowLeft" || e.key === "ArrowUp" ? -1 : 0;
    if (!d || e.target !== wrap) return; e.preventDefault(); act();
    const list = [...msgs].sort((a, b) => (a.danger === b.danger ? col[a.pair] - col[b.pair] : a.danger ? -1 : 1)), at = list.indexOf(msgs[sel]);
    sel = list[(at + d + list.length) % list.length].i; hover = -1; show();
  });
  });
</script>
