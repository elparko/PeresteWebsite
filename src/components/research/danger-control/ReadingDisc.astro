---
import "../../../styles/research-explainers.css";
import data from "../../../data/research/medication-danger-and-control/reading-disc.json";

interface Props {
  title?: string;
}

const { title } = Astro.props;
const f2 = (v: number) => v.toFixed(2);
const m = data.means;
const summary = `A tilted disc for ${data.model} with ${data.steps} rings, one per processing step, the outermost ring being step 1. The ${data.tokens.length} tokens of one dangerous message, “${data.message.text}”, sit around the rim, followed by the ${data.template.length} template tokens, the last of which is the reply position. A thread runs from each token through the steps to the reply position at the center, where the urgency reading is taken. Dots mark the 200 units that best predict danger, each at its step and neuron number. A lower plate stands for the harmless message it is paired with. Mean urgency reading over 30 pairs of messages: ${f2(m.rest[0])} for dangerous and ${f2(m.rest[1])} for harmless messages. With the 200 units silenced: ${f2(m.silenced[0])} and ${f2(m.silenced[1])}. With the attention output at the reply position swapped within each pair, an exploratory test: ${f2(m.attention[0])} and ${f2(m.attention[1])}. The threads are schematic.`;
---

<figure class="rd" data-rd>
  {title && <figcaption class="rd-title">{title}</figcaption>}
  <div class="rd-panel">
    <div class="stage"><canvas role="img" aria-label={summary}></canvas></div>
    <div class="rd-controls">
      <button type="button" data-mode="silenced" aria-pressed="false">silence 200</button>
      <button type="button" data-mode="attention" aria-pressed="false">swap attention <i>exploratory</i></button>
    </div>
    <p class="rd-key">
      <span><i class="u"></i><i class="o"></i>200 units, high / low end</span>
      <span><i class="n"></i>24 neurons</span>
      <span>threads schematic</span>
    </p>
  </div>
  <p class="line" aria-live="polite"></p>
  <script type="application/json" data-rd-data set:html={JSON.stringify(data).replace(/</g, "\\u003c")} />
</figure>

<script>
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const clamp = (v, a, b) => (v < a ? a : v > b ? b : v);
  const smooth = (t) => { t = clamp(t, 0, 1); return t * t * (3 - 2 * t); };
  const hash = (a, b) => { const f = Math.sin(a * 12.9898 + b * 78.233) * 43758.5453; return f - Math.floor(f); };
  const TAU = Math.PI * 2, RAD = Math.PI / 180, FONT = "Montserrat, system-ui, -apple-system, 'Segoe UI', sans-serif";
  const HUES = ["#b5534a", "#c0832f", "#7c8f43", "#3a9183", "#4878a8", "#7564a4", "#a65c88", "#8a6950"];
  const INK = "#2f2a24", SOFT = "#7a7064", FACE = "#fbf8f1", EDGE = "#d9cebb", LOWER = "#ebe3d2", DANGER = "#d2452f", HARMLESS = "#2f7fb5";

  document.querySelectorAll("[data-rd]").forEach((fig) => {
    const D = JSON.parse(fig.querySelector("[data-rd-data]").textContent);
    const wrap = fig.querySelector(".stage"), canvas = wrap.querySelector("canvas"), ctx = canvas.getContext("2d"), line = fig.querySelector(".line");
    const buttons = [...fig.querySelectorAll("[data-mode]")];
    const STEPS = D.steps, NPS = D.neurons_per_step, PER = 24, DOTS = NPS / PER, HUB = 0.1, REPLY = Math.PI / 2, TOP = 5.2, MARGIN = 12;
    const TOKENS = D.tokens.map((t) => t.trim() || t), half = Math.ceil(TOKENS.length / 2);
    const TEMPLATE = [-13.5, -10.5, -7.5, -4.5, 4.5, 7.5, 10.5, 13.5].slice(0, D.template.length - 1);
    const mk = (cls, text) => { const e = document.createElement("span"); e.className = cls; if (text != null) e.textContent = text; wrap.appendChild(e); return e; };
    const put = (el, x, y) => { el.style.transform = `translate(${x.toFixed(1)}px, ${y.toFixed(1)}px)`; };
    const shown = (t) => t.replace(/\n/g, "⏎");
    const words = TOKENS.map((text, i) => {
      const left = i < half, n = left ? half : TOKENS.length - half, j = left ? i : i - half;
      const a = ((left ? 106 : 296) + (left ? 150 : 138) * (n > 1 ? j / (n - 1) : 0.5)) * RAD;
      let d = REPLY - a; while (d > Math.PI) d -= TAU; while (d < -Math.PI) d += TAU;
      const el = mk("w " + (left ? "l" : "r"), text); el.style.setProperty("--c", HUES[i % HUES.length]);
      return { text, i, a, d, left, el, color: HUES[i % HUES.length], alpha: 1, width: 0 };
    });
    const tails = TEMPLATE.map((o) => ({ a: REPLY + o * RAD, d: -o * RAD }));
    const units = D.units.map(([layer, neuron, sign]) => ({ layer, neuron, sign, a: (TAU * neuron) / NPS - Math.PI / 2, x: 0, y: 0 }));
    const tplLabel = mk("t tpl"); tplLabel.append(D.template.slice(0, -1).map(shown).join(""), Object.assign(document.createElement("b"), { textContent: shown(D.template[D.template.length - 1]) }));
    const replyLabel = mk("t", "reply position");
    const mastLabel = mk("t mast"); mastLabel.append("log\u00a0p(High)\u00a0− log\u00a0p(Low)", document.createElement("br"), "mean,\u00a030\u00a0pairs");
    const idLabel = mk("t ins"); idLabel.append(`${D.model} · ${STEPS} × ${NPS.toLocaleString("en-US")}`, document.createElement("br"), `${D.message.id} · fold ${D.fold}`);
    const pairLabel = mk("t pair", D.pair.id);
    const nums = [mk("t num"), mk("t num")]; nums[0].style.color = DANGER; nums[1].style.color = HARMLESS;
    const tip = mk("tip"), cue = mk("t cue", matchMedia("(hover: none)").matches ? "Tap a token" : "Point at a token");
    wrap.tabIndex = 0; wrap.setAttribute("role", "group"); wrap.setAttribute("aria-label", "The message's tokens around the disc. Arrow keys move from token to token and follow each thread.");

    const f2 = (v) => v.toFixed(2);
    const M = D.means;
    const LINE = {
      rest: "",
      silenced: `${f2(M.rest[0])} → ${f2(M.silenced[0])} · ${f2(M.rest[1])} → ${f2(M.silenced[1])} · difference −0.027 (95% interval −0.044 to −0.014)`,
      attention: `${f2(M.rest[0])} → ${f2(M.attention[0])} · ${f2(M.rest[1])} → ${f2(M.attention[1])} · difference −1.86 (95% interval −2.17 to −1.60) · exploratory`,
    };

    let G = null, base = null, mode = "rest", hot = -1, sticky = -1, unitHot = -1, intro = 1, demo = 2, demoT = 0, phase = 0, sil = 0, att = 0;
    let raf = 0, last = 0, visible = false, seen = false, touched = false;
    const vals = [M.rest[0], M.rest[1]];
    const active = () => (hot >= 0 ? hot : sticky);
    const P = (r, a) => [G.cx + r * Math.cos(a), G.cy + r * G.k * Math.sin(a)];
    const ring = (s) => G.rx * (1 - ((1 - HUB) * (s - 1)) / (STEPS - 1));
    const along = (w, t) => P(G.rx * (1 - (1 - HUB) * t), w.a + w.d * Math.pow(t, 1.9));
    const request = () => { if (!raf && visible && G) raf = requestAnimationFrame(loop); };
    const act = () => { if (demo === 0 && mode !== "rest") setMode("rest"); demo = 2; if (!touched) { touched = true; cue.classList.add("seen"); } };

    function setMode(next) {
      mode = next;
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.mode === mode)));
      line.textContent = LINE[mode];
      request();
    }
    function setWord() {
      const a = active();
      words.forEach((w) => { w.el.classList.toggle("on", w.i === a); w.el.classList.toggle("dim", a >= 0 && w.i !== a); });
      phase = 0; request();
    }

    function build() {
      const W = wrap.clientWidth; if (!W) return;
      const small = W < 520, fpx = small ? 9.5 : W < 680 ? 11.5 : 12.5, k = small ? 0.72 : 0.56, gap = MARGIN + (small ? 4 : 6);
      ctx.font = `600 ${fpx}px ${FONT}`;
      let rx = small ? 150 : 300;
      words.forEach((w) => { w.width = ctx.measureText(w.text).width; rx = Math.min(rx, (W / 2 - gap - 8 - w.width) / Math.max(0.3, Math.abs(Math.cos(w.a)))); });
      rx = Math.max(56, rx);
      const ry = rx * k, rise = 0.17 * ry + 27, plate = small ? 10 : 14, cx = W / 2, cy = (small ? 48 : 42) + rise + ry;
      const front = cy + (rx + MARGIN) * k + plate, H = Math.round(front + (small ? 40 : 44));
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      G = { W, H, cx, cy, rx, ry, k, small, fpx, dpr, plate, U: (ry + rise) / TOP, gap: (rx * (1 - HUB)) / (STEPS - 1) };
      wrap.style.height = H + "px"; wrap.style.setProperty("--f", fpx + "px"); wrap.classList.toggle("small", small);
      canvas.width = Math.round(W * dpr); canvas.height = Math.round(H * dpr);

      const lh = fpx + 3.5;
      let prev = null;
      words.forEach((w) => {
        if (w.i === half) prev = null;
        const [x, y0] = P(rx + gap, w.a); let y = y0;
        if (prev) {
          const overlap = w.left ? x - w.width - 3 < prev.x && prev.x - prev.width - 3 < x : x < prev.x + prev.width + 3 && prev.x < x + w.width + 3;
          if (overlap && Math.abs(y - prev.y) < lh) y = prev.y + (y >= prev.y ? lh : -lh);
        }
        put(w.el, x, y); prev = { x, y, width: w.width };
      });
      units.forEach((u) => { [u.x, u.y] = P(ring(u.layer + 1), u.a); });
      put(tplLabel, cx, front + (small ? 12 : 14)); put(replyLabel, cx, front + (small ? 26 : 29));
      put(mastLabel, cx, cy - TOP * G.U - (small ? 22 : 19));
      put(cue, 12, 14); put(idLabel, W - 12, 18);
      put(pairLabel, cx + rx * 0.42, cy + (rx + MARGIN) * k * Math.sqrt(1 - 0.42 * 0.42) + plate * 0.62);

      base = document.createElement("canvas"); base.width = canvas.width; base.height = canvas.height;
      const g = base.getContext("2d"); g.setTransform(dpr, 0, 0, dpr, 0, 0);
      const R = rx + MARGIN;
      g.save(); g.translate(cx, cy + plate + 14); g.scale(1, k);
      const sh = g.createRadialGradient(0, 0, R * 0.84, 0, 0, R * 1.14); sh.addColorStop(0, "rgba(84,62,30,0.2)"); sh.addColorStop(1, "rgba(84,62,30,0)");
      g.fillStyle = sh; g.beginPath(); g.arc(0, 0, R * 1.14, 0, TAU); g.fill(); g.restore();
      const disc = (dy, fill, edge) => { g.beginPath(); g.ellipse(cx, cy + dy, R, R * k, 0, 0, TAU); g.fillStyle = fill; g.fill(); if (edge) { g.strokeStyle = edge; g.lineWidth = 1; g.stroke(); } };
      disc(plate + 4, EDGE); disc(plate, LOWER, "rgba(122,100,70,0.4)");
      g.strokeStyle = "rgba(112,92,66,0.3)"; g.lineWidth = 0.7;
      for (const q of [0.985, 0.955, 0.925]) { g.beginPath(); g.ellipse(cx, cy + plate, R * q, R * q * k, 0, 0, Math.PI); g.stroke(); }
      disc(4, EDGE); disc(0, FACE, "rgba(122,100,70,0.45)");
      g.strokeStyle = "rgba(96,78,56,0.75)"; g.lineWidth = 0.7; g.beginPath();
      for (let n = 0; n < NPS; n += 128) {
        const a = (TAU * n) / NPS - Math.PI / 2, long = n % 1024 === 0 ? MARGIN - 2.5 : n % 512 === 0 ? MARGIN - 5 : MARGIN - 7.5;
        g.moveTo(cx + (rx + 2.5) * Math.cos(a), cy + (rx + 2.5) * k * Math.sin(a)); g.lineTo(cx + (rx + 2.5 + long) * Math.cos(a), cy + (rx + 2.5 + long) * k * Math.sin(a));
      }
      g.stroke();
      for (let s = 1; s <= STEPS; s++) {
        g.beginPath(); g.ellipse(cx, cy, ring(s), ring(s) * k, 0, 0, TAU);
        g.strokeStyle = `rgba(112,92,66,${s === 1 || s % 8 === 0 ? 0.36 : 0.13})`; g.lineWidth = 0.7; g.stroke();
      }
      g.fillStyle = "#5e4c38";
      for (let s = 1; s <= STEPS; s++) {
        const r = ring(s); g.globalAlpha = (small ? 0.62 : 0.85) * (0.18 + (0.34 * r) / rx); g.beginPath();
        for (let i = 0; i < DOTS; i++) {
          const a = (TAU * (i + hash(s, i) * 0.8)) / DOTS, rr = r + (hash(i, s) - 0.5) * G.gap * 0.62, z = (small ? 0.6 : 0.8) + hash(s + 7, i) * 0.35;
          g.rect(cx + rr * Math.cos(a) - z / 2, cy + rr * k * Math.sin(a) - z / 2, z, z);
        }
        g.fill();
      }
      g.globalAlpha = 1; g.font = `500 ${small ? 7.5 : 8.5}px ${FONT}`; g.textBaseline = "middle"; g.lineJoin = "round"; g.textAlign = "center";
      g.strokeStyle = SOFT; g.lineWidth = 0.8; g.beginPath();
      for (let s = 1; s <= STEPS; s++) { const [x, y] = P(ring(s), 0), major = s === 1 || s % 8 === 0; g.moveTo(x, y); g.lineTo(x, y + (major ? 5 : 2.2)); }
      g.stroke();
      for (const s of small ? [1, 16, 32] : [1, 8, 16, 24, 32]) {
        const [x, y] = P(ring(s), 0), label = String(s).padStart(2, "0");
        g.strokeStyle = FACE; g.lineWidth = 3; g.strokeText(label, x, y + 11); g.fillStyle = SOFT; g.fillText(label, x, y + 11);
      }
      frame(0);
      request();
    }

    function frame(dt) {
      const { W, H, cx, cy, rx, k, small, dpr, U, plate } = G; let busy = false;
      if (intro < 1) { intro = Math.min(1, intro + dt / 2); busy = true; }
      else if (demo === 0) {
        demoT += dt; busy = true;
        const next = demoT < 1.1 ? "rest" : demoT < 3.7 ? "silenced" : demoT < 4.5 ? "rest" : demoT < 7.5 ? "attention" : null;
        if (next === null) { demo = 2; setMode("rest"); } else if (next !== mode) setMode(next);
      }
      const rate = still ? 1 : 1 - Math.exp(-dt * 5.5), fast = still ? 1 : 1 - Math.exp(-dt * 11), a = active();
      const ease = (cur, to, r) => { const d = to - cur; if (Math.abs(d) < 0.0015) return to; busy = true; return cur + d * r; };
      vals[0] = ease(vals[0], M[mode][0], rate); vals[1] = ease(vals[1], M[mode][1], rate);
      sil = ease(sil, mode === "silenced" ? 1 : 0, fast); att = ease(att, mode === "attention" ? 1 : 0, rate);
      words.forEach((w) => { w.alpha = ease(w.alpha, a < 0 || w.i === a ? 1 : 0.14, fast); });
      if (a >= 0 && !still) { phase = (phase + dt / 2.6) % 1; busy = true; }

      ctx.setTransform(dpr, 0, 0, dpr, 0, 0); ctx.clearRect(0, 0, W, H); ctx.drawImage(base, 0, 0, W, H);
      ctx.lineCap = "round"; ctx.lineJoin = "round";
      const grow = smooth(intro), N = 44;
      const trace = (w, from, to) => {
        ctx.beginPath();
        for (let q = 0; q <= N; q++) { const t = from + ((to - from) * q) / N, [x, y] = along(w, t); if (q) ctx.lineTo(x, y); else ctx.moveTo(x, y); }
        if (to >= 1) ctx.lineTo(cx, cy);
      };
      if (att > 0.01) { ctx.globalAlpha = att; ctx.strokeStyle = HARMLESS; ctx.lineWidth = 2; ctx.beginPath(); ctx.ellipse(cx, cy + plate, rx + MARGIN, (rx + MARGIN) * k, 0, 0.06 * Math.PI, 0.94 * Math.PI); ctx.stroke(); }
      ctx.strokeStyle = SOFT; ctx.lineWidth = 0.7; ctx.globalAlpha = a < 0 ? 0.8 : 0.25;
      for (const w of tails) { trace(w, 0, grow); ctx.stroke(); }
      for (const w of words) {
        const on = w.i === a;
        ctx.globalAlpha = (on ? 1 : 0.9) * w.alpha; ctx.strokeStyle = w.color; ctx.lineWidth = on ? 2.3 : small ? 0.95 : 1.1;
        trace(w, 0, grow); ctx.stroke();
      }
      const [fx, fy] = P(rx, REPLY), [hx, hy] = P(rx * (1 - (1 - HUB) * grow), REPLY);
      ctx.globalAlpha = 1; ctx.strokeStyle = INK; ctx.lineWidth = 1.6; ctx.beginPath(); ctx.moveTo(fx, fy); ctx.lineTo(hx, hy); if (grow >= 1) ctx.lineTo(cx, cy); ctx.stroke();
      ctx.fillStyle = INK; ctx.beginPath(); ctx.arc(fx, fy, 2.4, 0, TAU); ctx.fill();
      if (att > 0.01) {
        ctx.strokeStyle = HARMLESS;
        for (const w of words) { ctx.globalAlpha = att * w.alpha * 0.95; ctx.lineWidth = small ? 1.4 : 1.7; trace(w, 0.5, 1); ctx.stroke(); }
        ctx.globalAlpha = att * 0.8; ctx.lineWidth = 1; for (const w of tails) { trace(w, 0.5, 1); ctx.stroke(); }
        ctx.globalAlpha = att; ctx.lineWidth = 2.3; ctx.beginPath(); ctx.moveTo(fx, fy); ctx.lineTo(cx, cy); ctx.stroke();
      }

      const ur = small ? 1.2 : 1.8, arcs = (test) => { ctx.beginPath(); for (const u of units) if (test(u)) { ctx.moveTo(u.x + ur, u.y); ctx.arc(u.x, u.y, ur, 0, TAU); } };
      ctx.globalAlpha = 1; ctx.fillStyle = FACE; ctx.beginPath();
      for (const u of units) { ctx.moveTo(u.x + ur + 0.9, u.y); ctx.arc(u.x, u.y, ur + 0.9, 0, TAU); }
      ctx.fill();
      ctx.globalAlpha = 1 - sil; ctx.fillStyle = INK; arcs((u) => u.sign > 0); ctx.fill();
      ctx.strokeStyle = INK; ctx.lineWidth = small ? 0.8 : 1; arcs((u) => u.sign < 0); ctx.stroke();
      if (sil > 0.01) { ctx.globalAlpha = sil * 0.9; ctx.strokeStyle = "#b3a999"; ctx.lineWidth = 0.8; arcs(() => true); ctx.stroke(); }
      if (unitHot >= 0) { const u = units[unitHot]; ctx.globalAlpha = 1; ctx.strokeStyle = INK; ctx.lineWidth = 1.3; ctx.beginPath(); ctx.arc(u.x, u.y, ur + 3.6, 0, TAU); ctx.stroke(); }

      ctx.font = `600 ${small ? 8 : 9}px ${FONT}`; ctx.textBaseline = "middle";
      if (a >= 0 && intro >= 1) {
        const w = words[a], t = still ? 0.62 : phase, [x, y] = along(w, t), step = 1 + Math.round(t * (STEPS - 1));
        ctx.globalAlpha = 1; ctx.fillStyle = w.color; ctx.strokeStyle = FACE; ctx.lineWidth = 1.6; ctx.beginPath(); ctx.arc(x, y, 3.4, 0, TAU); ctx.fill(); ctx.stroke();
        const label = String(step).padStart(2, "0");
        ctx.textAlign = "left"; ctx.lineWidth = 3; ctx.strokeText(label, x + 7, y - 7); ctx.fillStyle = INK; ctx.fillText(label, x + 7, y - 7);
      }

      ctx.globalAlpha = 1; ctx.strokeStyle = INK; ctx.lineWidth = 1.4; ctx.beginPath(); ctx.moveTo(cx, cy); ctx.lineTo(cx, cy - TOP * U); ctx.stroke();
      ctx.lineWidth = 0.9; ctx.beginPath();
      for (let v = 0; v <= 5; v += 0.5) { const y = cy - v * U; ctx.moveTo(cx - (v % 1 ? 3 : 5.5), y); ctx.lineTo(cx, y); }
      ctx.stroke();
      ctx.font = `500 ${small ? 7.5 : 8.5}px ${FONT}`; ctx.textAlign = "right";
      for (const v of [0, 2, 4]) { const y = cy - v * U; ctx.strokeStyle = FACE; ctx.lineWidth = 3; ctx.strokeText(String(v), cx - 8.5, y); ctx.fillStyle = SOFT; ctx.fillText(String(v), cx - 8.5, y); }
      const br = small ? 4 : 5;
      [[vals[1], HARMLESS, nums[1]], [vals[0], DANGER, nums[0]]].forEach(([v, color, el]) => {
        const y = cy - v * U;
        ctx.fillStyle = color; ctx.strokeStyle = FACE; ctx.lineWidth = 1.8; ctx.beginPath(); ctx.arc(cx, y, br, 0, TAU); ctx.fill(); ctx.stroke();
        el.textContent = f2(v); put(el, cx + br + 5, y);
      });
      ctx.globalAlpha = 1;
      return busy;
    }

    function loop(now) {
      raf = 0; const dt = last ? Math.min(0.05, (now - last) / 1000) : 0.016; last = now;
      if (frame(dt) && visible) raf = requestAnimationFrame(loop); else last = 0;
    }

    function nearUnit(e, reach) {
      const b = canvas.getBoundingClientRect(), x = e.clientX - b.left, y = e.clientY - b.top; let best = -1, d = reach * reach;
      units.forEach((u, i) => { const q = (u.x - x) ** 2 + (u.y - y) ** 2; if (q < d) { d = q; best = i; } });
      return best;
    }
    function setUnit(i) {
      if (i === unitHot) return; unitHot = i;
      if (i < 0) tip.classList.remove("show");
      else {
        const u = units[i]; tip.textContent = `step ${u.layer + 1} · neuron ${u.neuron.toLocaleString("en-US")} · ${u.sign > 0 ? "high" : "low"} end`;
        tip.classList.add("show"); const tw = tip.offsetWidth; put(tip, clamp(u.x - tw / 2, 4, G.W - tw - 4), u.y < 44 ? u.y + 12 : u.y - 30);
      }
      wrap.style.cursor = i >= 0 ? "pointer" : ""; request();
    }

    words.forEach((w) => {
      w.el.addEventListener("pointerenter", (e) => { if (e.pointerType !== "touch") { act(); hot = w.i; setWord(); } });
      w.el.addEventListener("pointerleave", () => { if (hot === w.i) { hot = -1; setWord(); } });
      w.el.addEventListener("click", (e) => { e.stopPropagation(); act(); sticky = sticky === w.i ? -1 : w.i; hot = -1; setWord(); });
    });
    wrap.addEventListener("pointermove", (e) => { if (e.pointerType !== "touch") { const i = nearUnit(e, 10); if (i >= 0) act(); setUnit(i); } });
    wrap.addEventListener("pointerleave", () => setUnit(-1));
    wrap.addEventListener("click", (e) => { act(); const i = nearUnit(e, 18); setUnit(i === unitHot && e.pointerType === "touch" ? -1 : i); if (i < 0 && sticky >= 0) { sticky = -1; setWord(); } });
    wrap.addEventListener("keydown", (e) => {
      if (e.key === "Escape") { sticky = -1; setWord(); return; }
      const d = e.key === "ArrowRight" || e.key === "ArrowDown" ? 1 : e.key === "ArrowLeft" || e.key === "ArrowUp" ? -1 : 0;
      if (!d) return; e.preventDefault(); act();
      sticky = sticky < 0 ? (d > 0 ? 0 : words.length - 1) : (sticky + d + words.length) % words.length; setWord();
    });
    buttons.forEach((b) => b.addEventListener("click", () => { act(); setMode(mode === b.dataset.mode ? "rest" : b.dataset.mode); }));

    new IntersectionObserver((es) => {
      visible = es.some((e) => e.isIntersecting);
      if (visible && G && !seen) {
        seen = true;
        if (!still) {
          intro = 0; demo = 0; demoT = 0;
          setTimeout(() => { if (intro < 1) { intro = 1; demo = 2; setMode("rest"); frame(0); } }, 3200);
        }
      }
      request();
    }, { threshold: 0.15 }).observe(wrap);
    new ResizeObserver(() => { if (!G || wrap.clientWidth !== G.W) build(); }).observe(wrap);
    setMode("rest"); build();
    if (document.fonts) { document.fonts.load("600 13px Montserrat").then(build, () => {}); document.fonts.addEventListener("loadingdone", build); }
  });
</script>
