---
import "../../../styles/research.css";
import "../../../styles/research-explainers.css";
import ladder from "../../../data/research/medication-danger-and-control/ladder.json";
import info from "../../../data/research/medication-danger-and-control/swap-explainer.json";

interface Props {
  title: string;
  how: string;
}

const { title, how } = Astro.props;

const GAP = ladder.gap;
const MAX = 5;
const STEPS = 32;
const rowsByLabel = new Map(ladder.parts.map((r) => [r.label, r]));

const sign = (v: number, d = 2) => (v < 0 ? `−${Math.abs(v).toFixed(d)}` : `+${v.toFixed(d)}`);
const digits = (v: number) => (Math.abs(v) < 0.1 ? 3 : 2);

const abs = (v: number) => Math.abs(v).toFixed(digits(v));
const fineOf = (r: { change: number; ci: number[]; detectable: number }) => {
  const [lo, hi] = r.ci;
  const how =
    hi < 0
      ? `Lowered the gap by ${abs(r.change)} (95% interval ${abs(hi)} to ${abs(lo)})`
      : lo > 0
        ? `Raised the gap by ${abs(r.change)} (95% interval ${abs(lo)} to ${abs(hi)})`
        : `Changed the gap by ${sign(r.change, 2)} (95% interval ${abs(lo)} lower to ${abs(hi)} higher)`;
  return `${how}. Smallest change this test had an 80% chance of detecting: ${r.detectable.toFixed(digits(r.detectable))}.`;
};

const states = info.states.map((s) => {
  const r = s.row ? rowsByLabel.get(s.row) : null;
  if (s.row && !r) throw new Error(`SwapExplainer: no ladder row named ${s.row}`);
  return {
    ...s,
    change: r ? r.change : 0,
    detectable: r ? r.detectable : 0,
    detected: r ? r.detected : false,
    value: r ? sign(r.change, r.detected && Math.abs(r.change) < 0.1 ? 3 : 2) : "4.33",
    fine: r ? fineOf(r) : "",
  };
});

const DANGER_SEED = [7, 8, 10, 11, 13, 14, 15, 17, 18, 20, 21, 22, 24, 25, 27, 28, 29, 30, 31];
const HARMLESS_SEED = [7, 9, 10, 12, 13, 14, 16, 17, 19, 20, 21, 23, 24, 26, 27, 28, 29, 30, 31];

type Layout = {
  key: string;
  w: number;
  h: number;
  x0: number;
  cw: number;
  pitch: number;
  nMsg: number;
  groupGap: number;
  replyW: number;
  top: number;
  laneGap: number;
  rowH: number;
  dial: { cx: number; cy: number; r: number; box: [number, number, number, number] };
  laneLabels: "side" | "rotated";
  leads: (ends: { x: number; yTop: number; yBot: number }) => [string, string];
};

const LAYOUTS: Layout[] = [
  {
    key: "wide",
    w: 620,
    h: 300,
    x0: 108,
    cw: 16,
    pitch: 19,
    nMsg: 9,
    groupGap: 10,
    replyW: 38,
    top: 38,
    laneGap: 68,
    rowH: 3,
    dial: { cx: 548, cy: 178, r: 54, box: [478, 84, 140, 164] },
    laneLabels: "side",
    leads: ({ x, yTop, yBot }) => [
      `M${x} ${yTop + 1.5}H${x + 14}a6 6 0 0 1 6 6V${118}a6 6 0 0 0 6 6H478`,
      `M${x} ${yBot + 1.5}H${x + 22}a6 6 0 0 1 6 6V${222}a6 6 0 0 0 6 6H478`,
    ],
  },
  {
    key: "narrow",
    w: 340,
    h: 472,
    x0: 44,
    cw: 14,
    pitch: 17,
    nMsg: 6,
    groupGap: 8,
    replyW: 28,
    top: 34,
    laneGap: 60,
    rowH: 3,
    dial: { cx: 170, cy: 404, r: 64, box: [62, 304, 216, 162] },
    laneLabels: "rotated",
    leads: ({ x, yTop, yBot }) => [
      `M${x} ${yTop + 1.5}H${x + 30}a6 6 0 0 1 6 6V${326}a6 6 0 0 1 -6 6H278`,
      `M${x} ${yBot + 1.5}H${x + 16}a6 6 0 0 1 6 6V${346}a6 6 0 0 1 -6 6H278`,
    ],
  },
];

const angleOf = (v: number) => 180 + (Math.min(MAX, Math.max(0, v)) / MAX) * 180;
const polar = (cx: number, cy: number, r: number, deg: number) => {
  const a = (deg * Math.PI) / 180;
  return [cx + r * Math.cos(a), cy + r * Math.sin(a)];
};
const f = (n: number) => +n.toFixed(2);
const arc = (cx: number, cy: number, r: number, from: number, to: number) => {
  const [x1, y1] = polar(cx, cy, r, angleOf(from));
  const [x2, y2] = polar(cx, cy, r, angleOf(to));
  return `M${f(x1)} ${f(y1)}A${r} ${r} 0 0 1 ${f(x2)} ${f(y2)}`;
};

function draw(L: Layout) {
  const id = `sx-${L.key}`;
  const laneH = STEPS * L.rowH;
  const lanes = [
    { key: "danger", y: L.top, seed: DANGER_SEED, dir: 1 },
    { key: "harmless", y: L.top + laneH + L.laneGap, seed: HARMLESS_SEED, dir: -1 },
  ];
  const D = laneH + L.laneGap;
  const msgEnd = L.x0 + (L.nMsg - 1) * L.pitch + L.cw;
  const tplStart = msgEnd + L.groupGap;
  const tplEnd = tplStart + 2 * L.pitch + L.cw;
  const rx = tplEnd + L.groupGap;
  const prefStart = rx + L.replyW + L.groupGap;
  const prefEnd = prefStart + 2 * L.pitch + L.cw;
  const cols = [
    ...Array.from({ length: L.nMsg }, (_, i) => L.x0 + i * L.pitch),
    ...[0, 1, 2].map((i) => tplStart + i * L.pitch),
    ...[0, 1, 2].map((i) => prefStart + i * L.pitch),
  ];
  const half = L.replyW / 2;
  const out: string[] = [];

  out.push(
    `<defs>` +
      ["danger", "harmless"]
        .map(
          (k) =>
            `<pattern id="${id}-rows-${k}" width="4" height="${L.rowH}" patternUnits="userSpaceOnUse" y="${L.top}"><rect class="sx-row-${k}" width="4" height="${L.rowH - 0.8}"/></pattern>` +
            `<linearGradient id="${id}-glow-${k}" x1="0" y1="1" x2="0" y2="0"><stop offset="0" class="sx-glow-${k}" stop-opacity="0"/><stop offset="0.7" class="sx-glow-${k}" stop-opacity="0.85"/><stop offset="1" class="sx-glow-${k}" stop-opacity="0"/></linearGradient>`,
        )
        .join("") +
      lanes.map((lane) => `<clipPath id="${id}-clip-${lane.key}"><rect x="0" y="${lane.y}" width="${L.w}" height="${laneH}"/></clipPath>`).join("") +
      `</defs>`,
  );

  const head = L.top - 12;
  const bracket = (x1: number, x2: number, text: string, anchor = "middle", lift = 0) => {
    const tx = anchor === "middle" ? (x1 + x2) / 2 : anchor === "end" ? x2 : x1;
    const stem = lift ? `<path class="sx-bracket" d="M${f(tx)} ${head + 2}V${head - lift + 1}"/>` : "";
    return `<path class="sx-bracket" d="M${x1} ${head + 5}V${head + 2}H${x2}V${head + 5}"/>${stem}<text class="sx-head" x="${f(tx)}" y="${head - 3 - lift}" text-anchor="${anchor}">${text}</text>`;
  };
  out.push(bracket(L.x0, msgEnd, "the message"));
  out.push(bracket(tplStart, rx + L.replyW, L.key === "wide" ? "chat template" : "template"));
  out.push(bracket(prefStart, prefEnd, "“Urgency level:”", "middle", L.key === "wide" ? 0 : 0));

  for (const lane of lanes) {
    const m = info.messages[lane.key as "danger" | "harmless"];
    out.push(`<g class="sx-lane sx-${lane.key}">`);
    for (const x of cols) {
      out.push(`<rect class="sx-cell" x="${x}" y="${lane.y}" width="${L.cw}" height="${laneH}" fill="url(#${id}-rows-${lane.key})"/>`);
    }
    const glows = cols
      .map((x, c) => {
        const group = c < L.nMsg + 3 ? "pre" : "post";
        return `<rect class="sx-glow sx-glow-${group}" x="${x}" y="${lane.y + laneH}" width="${L.cw}" height="22" fill="url(#${id}-glow-${lane.key})" style="--c:${c};--p:${c - L.nMsg - 3};--h:${laneH + 22}px"/>`;
      })
      .join("");
    out.push(`<g clip-path="url(#${id}-clip-${lane.key})">${glows}</g>`);
    out.push(`<rect class="sx-slot" x="${rx - 2}" y="${lane.y - 2}" width="${L.replyW + 4}" height="${laneH + 3.2}" rx="3"/>`);
    if (L.laneLabels === "side") {
      const cy = lane.y + laneH / 2;
      out.push(
        `<text class="sx-lane-name" x="0" y="${cy - 6}">${m.label.split(" ")[0]}</text><text class="sx-lane-name" x="0" y="${cy + 8}">message</text><text class="sx-lane-level" x="0" y="${cy + 22}">${m.level}</text>`,
      );
      out.push(
        `<text class="sx-step" x="${L.x0 - 6}" y="${lane.y + 4}" text-anchor="end">step 32</text><text class="sx-step" x="${L.x0 - 6}" y="${lane.y + laneH}" text-anchor="end">step 1</text>`,
      );
    } else {
      const cy = lane.y + laneH / 2;
      out.push(
        `<text class="sx-lane-name" transform="translate(12 ${cy}) rotate(-90)" text-anchor="middle">${m.label.split(" ")[0]}, ${m.level.replace("danger level ", "")}</text>`,
      );
      out.push(
        `<text class="sx-step" x="${L.x0 - 5}" y="${lane.y + 4}" text-anchor="end">32</text><text class="sx-step" x="${L.x0 - 5}" y="${lane.y + laneH}" text-anchor="end">1</text>`,
      );
    }
    out.push(`</g>`);
  }

  const moving: string[] = [];
  for (const lane of lanes) {
    const side = lane.dir > 0 ? "top" : "bot";
    for (let s = 0; s < STEPS; s++) {
      const y = lane.y + laneH - (s + 1) * L.rowH;
      const delay = `--i:${s}`;
      moving.push(
        `<rect class="sx-a sx-${side} sx-c-${lane.key}" x="${rx}" y="${y}" width="${half - 0.6}" height="${L.rowH - 0.8}" style="${delay}"/>`,
        `<rect class="sx-f sx-${side} sx-c-${lane.key}" x="${rx + half + 0.6}" y="${y}" width="${half - 0.6}" height="${L.rowH - 0.8}" style="${delay}"/>`,
      );
    }
    const dots = lane.seed
      .map((s, k) => {
        const y = lane.y + laneH - (s + 1) * L.rowH + (L.rowH - 0.8) / 2;
        const x = rx + half + 0.6 + (half - 0.6) * (0.25 + 0.5 * ((k * 7) % 5) / 4);
        return `<circle class="sx-dot" cx="${f(x)}" cy="${f(y)}" r="1.75" style="--i:${k}"/>`;
      })
      .join("");
    moving.push(`<g class="sx-dots">${dots}</g>`);
  }
  out.push(`<g class="sx-moving" style="--D:${D}px">${moving.join("")}</g>`);

  const gy1 = L.top + laneH + 5;
  const gy2 = L.top + laneH + L.laneGap - 5;
  const mx = rx + L.replyW / 2;
  out.push(
    `<g class="sx-swap"><path d="M${mx} ${gy1 + 4}V${gy2 - 4}"/><path d="M${mx - 3.5} ${gy1 + 7.5}L${mx} ${gy1 + 3}L${mx + 3.5} ${gy1 + 7.5}M${mx - 3.5} ${gy2 - 7.5}L${mx} ${gy2 - 3}L${mx + 3.5} ${gy2 - 7.5}"/></g>`,
  );
  out.push(
    `<text class="sx-reply" x="${mx - 12}" y="${(gy1 + gy2) / 2 - 2}" text-anchor="end">reply position</text><text class="sx-reply-sub" x="${mx - 12}" y="${(gy1 + gy2) / 2 + 11}" text-anchor="end">last template token, before “Urgency level:”</text>`,
  );

  const [lt, lb] = L.leads({ x: prefEnd, yTop: lanes[0].y, yBot: lanes[1].y });
  out.push(
    `<path class="sx-lead sx-lead-danger" d="${lt}"/><path class="sx-lead sx-lead-harmless" d="${lb}"/>` +
      `<path class="sx-pulse sx-lead-danger" d="${lt}" pathLength="100"/><path class="sx-pulse sx-lead-harmless" d="${lb}" pathLength="100"/>`,
  );

  const { cx, cy, r, box } = L.dial;
  const [bx, by, bw, bh] = box;
  const ticks: string[] = [];
  for (let v = 0; v <= MAX + 1e-9; v += 0.25) {
    const major = Math.abs(v - Math.round(v)) < 1e-9;
    const [x1, y1] = polar(cx, cy, r - (major ? 7 : 4), angleOf(v));
    const [x2, y2] = polar(cx, cy, r, angleOf(v));
    ticks.push(`<path class="${major ? "sx-tick-major" : "sx-tick"}" d="M${f(x1)} ${f(y1)}L${f(x2)} ${f(y2)}"/>`);
    if (major) {
      const [tx, ty] = polar(cx, cy, r + 9, angleOf(v));
      ticks.push(`<text class="sx-num" x="${f(tx)}" y="${f(ty + 3)}" text-anchor="middle">${v}</text>`);
    }
  }
  const bands = states
    .filter((s) => s.detectable > 0)
    .map(
      (s) =>
        `<path class="sx-band" data-for="${s.id}" d="${arc(cx, cy, r - 3, GAP - s.detectable, GAP + s.detectable)}" style="stroke-width:${L.key === "wide" ? 6 : 7}"/>`,
    )
    .join("");
  const base = (() => {
    const a = angleOf(GAP);
    const p = (rr: number, da: number) => polar(cx, cy, rr, a + da).map(f).join(" ");
    return `<path class="sx-base" d="M${p(r + 1, 0)}L${p(r + 7, -3.2)}L${p(r + 7, 3.2)}Z"/>`;
  })();
  const vy = cy + (L.key === "wide" ? 24 : 28);
  const values = states
    .map(
      (s) =>
        `<g class="sx-value" data-for="${s.id}"><text class="sx-value-num" x="${cx}" y="${vy}" text-anchor="middle">${s.id === "none" ? GAP.toFixed(2) : s.value}</text>` +
        `<text class="sx-value-sub" x="${cx}" y="${vy + 13}" text-anchor="middle">${s.id === "none" ? "urgency gap" : `change from ${GAP}`}</text></g>`,
    )
    .join("");
  out.push(
    `<g class="sx-dial"><rect class="sx-box" x="${bx}" y="${by}" width="${bw}" height="${bh}" rx="12"/>` +
      `<circle class="sx-port" cx="${L.key === "wide" ? bx : bx + bw}" cy="${L.key === "wide" ? 124 : 332}" r="2.6"/>` +
      `<circle class="sx-port" cx="${L.key === "wide" ? bx : bx + bw}" cy="${L.key === "wide" ? 228 : 352}" r="2.6"/>` +
      `<path class="sx-arc" d="${arc(cx, cy, r, 0, MAX)}"/>${bands}${ticks.join("")}${base}` +
      `<g transform="translate(${cx} ${cy})"><g class="sx-needle"><path d="M-6 0L${r - 6} -0.9L${r - 6} 0.9Z"/><circle r="4.2"/><circle class="sx-hub" r="1.6"/></g></g>` +
      values +
      `<text class="sx-dial-label" x="${cx}" y="${by + 16}" text-anchor="middle">urgency gap</text>` +
      `</g>`,
  );

  return `<svg class="sx-svg sx-svg-${L.key}" viewBox="0 0 ${L.w} ${L.h}" role="img" aria-labelledby="sx-desc">${out.join("")}</svg>`;
}

const svgs = LAYOUTS.map(draw).join("");
const needleCss = states
  .map((s) => `.sx[data-state="${s.id}"] .sx-needle{transform:rotate(${f(angleOf(GAP + s.change))}deg)}`)
  .join("");
const desc = `Diagram of the swap test on Qwen3.5-4B. The same model reads a dangerous and a harmless message in two rows of 32 steps. At the reply position, parts of each message's state can be swapped with the other's or silenced, and a dial shows the change in the urgency gap of ${GAP}. ${states
  .filter((s) => s.row)
  .map((s) => `${s.button}: ${s.value} (${s.tag.toLowerCase()}).`)
  .join(" ")}`;
---

<figure class="rfig sx" data-sx data-state="none">
  <figcaption class="rfig-head">
    <span class="rfig-num">How the test works</span>
    <span class="rfig-title">{title}</span>
  </figcaption>
  <p class="sx-how">{how}</p>

  <div class="sx-msgs">
    <p class="sx-msg sx-msg-danger"><span class="sx-msg-who">{info.messages.danger.label}, {info.messages.danger.level}</span>“{info.messages.danger.text}”</p>
    <p class="sx-msg sx-msg-harmless"><span class="sx-msg-who">{info.messages.harmless.label}, {info.messages.harmless.level}</span>“{info.messages.harmless.text}”</p>
  </div>

  <div class="sx-stage">
    <Fragment set:html={svgs} />
    <p id="sx-desc" class="sx-sr">{desc}</p>
  </div>

  <div class="sx-legend" aria-hidden="true">
    <span class="sx-key sx-key-a">Attention part of each step: brings in information from earlier tokens</span>
    <span class="sx-key sx-key-f">Feed-forward neurons: work on this token alone; a neuron's high and low ends are its two units</span>
    <span class="sx-key sx-key-dot">White dots, when silencing: the units silenced, about 19 per message</span>
    <span class="sx-key sx-key-band">Shaded arc on the dial: the smallest change the test had an 80% chance of detecting</span>
  </div>

  <div class="sx-controls" role="group" aria-label="Change made at the reply position">
    {states.map((s) => (
      <button type="button" class="sx-btn" data-set={s.id} aria-pressed={s.id === "none" ? "true" : "false"} aria-controls="sx-readout">
        <span class="sx-btn-label">{s.button}</span>
        <span class="sx-btn-short">{s.short}</span>
        <span class="sx-btn-value">{s.row ? s.value : `gap ${GAP}`}</span>
      </button>
    ))}
  </div>

  <div id="sx-readout" class="sx-readout" aria-live="polite">
    {states.map((s) => (
      <div class="sx-panel" data-panel={s.id} hidden={s.id !== "none"}>
        {s.tag && <span class={`sx-tag sx-tag-${s.id}`}>{s.tag}</span>}
        <p>{s.say}</p>
        {s.fine && (
          <p class="sx-fine">{s.fine}</p>
        )}
      </div>
    ))}
  </div>
  <style set:html={needleCss}></style>
</figure>

<script>
  document.querySelectorAll<HTMLElement>("[data-sx]").forEach((fig) => {
    const buttons = [...fig.querySelectorAll<HTMLButtonElement>("[data-set]")];
    const panels = fig.querySelectorAll<HTMLElement>("[data-panel]");
    const replay = (cls: string) => {
      fig.classList.remove("sx-intro", "sx-run");
      void fig.offsetWidth;
      fig.classList.add(cls);
    };
    const seen = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        seen.disconnect();
        replay("sx-intro");
      },
      { threshold: 0.4 },
    );
    seen.observe(fig);
    const pick = (id: string) => {
      if (fig.dataset.state === id) return;
      fig.dataset.state = id;
      replay("sx-run");
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.set === id)));
      panels.forEach((p) => (p.hidden = p.dataset.panel !== id));
    };
    buttons.forEach((b, i) => {
      b.addEventListener("click", () => pick(b.dataset.set!));
      b.addEventListener("keydown", (e) => {
        const step = e.key === "ArrowDown" || e.key === "ArrowRight" ? 1 : e.key === "ArrowUp" || e.key === "ArrowLeft" ? -1 : 0;
        if (!step) return;
        e.preventDefault();
        const next = buttons[(i + step + buttons.length) % buttons.length];
        next.focus();
        pick(next.dataset.set!);
      });
    });
  });
</script>
