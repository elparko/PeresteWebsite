---
import data from "../../../data/research/medication-danger-and-control/strings-explainer.json";

const { about, ...payload } = data;
const summary = "Two strings and a bank of 200 fine strings. The upper string is pulled to 4.46, the mean urgency reading for dangerous messages; the lower to 0.13, for harmless ones. Silencing the 200 units leaves them at 4.44 and 0.14. Exchanging the attention output between the two messages of each pair gives 3.89 and 1.43 (exploratory test).";
---

<figure class="ss" data-ss>
  <div class="ss-stage">
    <canvas class="ss-canvas" role="img" aria-label={summary}></canvas>
    <button type="button" class="ss-btn ss-units" aria-pressed="false">200 units</button>
    <button type="button" class="ss-btn ss-att" aria-pressed="false">attention<small>exploratory</small></button>
    <button type="button" class="ss-btn ss-sound" aria-pressed="false">sound</button>
  </div>
  <p class="ss-line" aria-live="polite"></p>
  <script type="application/json" data-ss-data set:html={JSON.stringify(payload).replace(/</g, "\\u003c")} />
</figure>

<style is:global>
  .ss { --bg: #ffffff; --ink: #232c54; --muted: #5a6472; --danger: #b4532a; --harmless: #0f8794; --font: "Montserrat", ui-sans-serif, system-ui, sans-serif; margin: 2.5rem 0; }
  .ss-stage { position: relative; touch-action: pan-y; }
  .ss-canvas { display: block; width: 100%; }
  .ss .ss-btn { position: absolute; font: 500 11px/1.2 var(--font); letter-spacing: 0.02em; color: var(--ink); background: none; border: 0; padding: 4px 2px; cursor: pointer; text-align: left; text-decoration: underline dotted; text-underline-offset: 4px; text-decoration-color: var(--muted); }
  .ss .ss-btn small { display: block; font-size: 9px; font-weight: 400; color: var(--muted); letter-spacing: 0.04em; margin-top: 3px; }
  .ss .ss-btn[aria-pressed="true"] { font-weight: 600; text-decoration-style: solid; text-decoration-color: currentColor; }
  .ss .ss-btn:focus-visible { outline: 1.5px solid var(--ink); outline-offset: 2px; border-radius: 3px; }
  .ss .ss-sound { right: 0; top: 0; color: var(--muted); font-size: 10px; }
  .prose-page .ss .ss-line, .ss .ss-line { margin: 0.6rem 0 0; font-size: 0.85rem; line-height: 1.5; color: var(--muted); min-height: 3em; }
  .ss .ss-line strong { color: var(--ink); font-weight: 600; font-variant-numeric: tabular-nums; }
</style>

<script>
  // @ts-nocheck
  document.querySelectorAll("[data-ss]").forEach((fig) => {

const D = JSON.parse(fig.querySelector("[data-ss-data]").textContent);
const LINES = {
  rest: "Touch the <strong>200</strong> fine strings to still them. Then exchange the two small pieces marked attention.",
  silenced: "All 200 units silenced. The readings hold: <strong>4.44</strong> and <strong>0.14</strong>.",
  attention: "Attention exchanged within each pair, at the point where the reply begins: <strong>3.89</strong> and <strong>1.43</strong>. Exploratory test.",
};
const NUM = { rest: ["4.46", "0.13"], silenced: ["4.44", "0.14"], attention: ["3.89", "1.43"] };
const stage = fig.querySelector(".ss-stage"), canvas = fig.querySelector(".ss-canvas"), ctx = canvas.getContext("2d");
const bUnits = fig.querySelector(".ss-units"), bAtt = fig.querySelector(".ss-att"), bSound = fig.querySelector(".ss-sound"), line = fig.querySelector(".ss-line");
const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
const N = 30, TW = 650;
let state = "rest", from = "rest", t0 = -1e9;
let W = 0, H = 0, dpr = 1, s = 11, x0, x1, yA, yB, bankTop, bankLen, cx, cy, ry;
let col = {}, colDirty = true;
const units = D.units.map((u, i) => ({ step: u[0] + 1, f: u[1] / D.neurons, ring: 0, to: 0, pluck: 0, ph: (i * 2.399) % 6.283 }));
let seed = 11; const rnd = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
const pickSet = () => { const p = (17 + Math.floor(rnd() * 5)) / units.length; units.forEach(u => (u.to = rnd() < p ? 1 : 0)); let c = units.filter(u => u.to).length;
  while (c < 17) { const u = units[Math.floor(rnd() * units.length)]; if (!u.to) { u.to = 1; c++; } } };
pickSet(); units.forEach(u => (u.ring = u.to));
let lastSet = 0;

const css = n => getComputedStyle(fig).getPropertyValue(n).trim();
const rgba = (hex, a) => { const v = parseInt(hex.slice(1), 16); return `rgba(${v >> 16},${(v >> 8) & 255},${v & 255},${a})`; };
const ease = p => 1 - Math.pow(1 - Math.min(1, Math.max(0, p)), 3);
const ux = u => x0 + (u.step - 1 + 0.08 + u.f * 0.84) / D.steps * (x1 - x0);
const ulen = u => bankLen * (0.38 + 0.62 * Math.pow((u.step - 8) / 24, 0.75));

function layout() {
  W = stage.clientWidth; const phone = W < 520;
  s = phone ? 8 : 11.5; bankLen = phone ? 70 : 88;
  x0 = 6; x1 = W - (phone ? 84 : 86);
  yA = 22 + 7.5 * s; yB = yA + 4.6 * s + 30; bankTop = yB + 1.9 * s + 46; H = Math.round(bankTop + bankLen + 30);
  cx = x1; cy = (yA + yB) / 2; ry = (yB - yA) / 2;
  dpr = Math.min(2.5, window.devicePixelRatio || 1);
  canvas.width = Math.round(W * dpr); canvas.height = Math.round(H * dpr); canvas.style.height = H + "px";
  bUnits.style.left = x0 + "px"; bUnits.style.top = bankTop + 30 + "px";
  bAtt.style.left = x1 + 24 + "px"; bAtt.style.top = cy - 16 + "px";
  draw(performance.now());
}

function arcs(base, a, b, p, color, now, bold) {
  for (let k = 0; k <= N; k++) {
    const mean = k === N;
    let v;
    if (mean) { let m = 0; for (let j = 0; j < N; j++) m += a[j] + (b[j] - a[j]) * p; v = m / N; } else v = a[k] + (b[k] - a[k]) * p;
    const wob = still || mean ? 0 : (0.5 + 0.1 * Math.abs(v)) * Math.sin(now / 190 + k * 1.7);
    ctx.beginPath();
    for (let i = 0; i <= 48; i++) { const u = i / 48, x = x0 + u * (x1 - x0), y = base - v * s * Math.sin(Math.PI * u) + wob * Math.sin(2 * Math.PI * u); i ? ctx.lineTo(x, y) : ctx.moveTo(x, y); }
    ctx.strokeStyle = rgba(color, mean ? 1 : 0.3); ctx.lineWidth = mean ? 1.7 : 0.7; ctx.stroke();
  }
}
function diamond(x, y, color) { ctx.save(); ctx.translate(x, y); ctx.rotate(Math.PI / 4); ctx.fillStyle = col.bg; ctx.fillRect(-6.5, -6.5, 13, 13); ctx.fillStyle = color; ctx.fillRect(-4.5, -4.5, 9, 9); ctx.restore(); }

function draw(now) {
  if (colDirty) { for (const n of ["bg", "ink", "muted", "danger", "harmless"]) col[n] = css("--" + n); colDirty = false; }
  const p = still ? 1 : ease((now - t0) / TW);
  const sil = state === "silenced" ? p : from === "silenced" ? 1 - p : 0;
  const sw = state === "attention" ? p : from === "attention" ? 1 - p : 0;
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0); ctx.clearRect(0, 0, W, H);
  ctx.font = `500 11px ${css("--font")}`; ctx.textBaseline = "alphabetic";

  // the two strings
  [[yA, 0, col.danger, "dangerous"], [yB, 1, col.harmless, "harmless"]].forEach(([y, i, c, word]) => {
    ctx.beginPath(); ctx.moveTo(x0, y); ctx.lineTo(x1, y); ctx.strokeStyle = rgba(col.ink, 0.22); ctx.lineWidth = 0.6; ctx.stroke();
    arcs(y, D.msgs[from][i], D.msgs[state][i], p, c, now);
    const ly = i ? y + 1.9 * s + 16 : y + 18;
    ctx.textAlign = "left"; ctx.fillStyle = c; ctx.font = `500 11px ${css("--font")}`; ctx.fillText(word, x0, ly);
    const w = ctx.measureText(word).width; ctx.fillStyle = col.ink; ctx.font = `600 12px ${css("--font")}`; ctx.fillText(NUM[state][i], x0 + w + 8, ly);
    ctx.beginPath(); ctx.arc(x0, y, 2, 0, 6.2832); ctx.fillStyle = rgba(col.ink, 0.5); ctx.fill();
  });

  // the exchange loop and the two attention pieces
  ctx.beginPath(); ctx.ellipse(cx, cy, 15, ry, 0, 0, 6.2832); ctx.setLineDash([2, 4]); ctx.strokeStyle = rgba(col.ink, 0.35); ctx.lineWidth = 0.8; ctx.stroke(); ctx.setLineDash([]);
  const sx = 15 * Math.sin(Math.PI * sw), sy = ry * Math.cos(Math.PI * sw);
  diamond(cx + sx, cy - sy, col.danger); diamond(cx - sx, cy + sy, col.harmless);

  // the bank of 200
  ctx.beginPath(); ctx.moveTo(x0, bankTop); ctx.lineTo(x1, bankTop); ctx.strokeStyle = rgba(col.ink, 0.45); ctx.lineWidth = 0.9; ctx.stroke();
  for (const u of units) {
    const x = ux(u), L = ulen(u), live = (1 - sil) * Math.max(u.ring, u.pluck) + sil * u.pluck * 0.25;
    if (live > 0.03) {
      const amp = (1.3 + 1.6 * u.pluck) * live, ph = still ? 1 : Math.sin(now / 38 + u.ph);
      ctx.strokeStyle = rgba(col.danger, 0.35 + 0.6 * live); ctx.lineWidth = 0.9;
      for (const sg of [-1, 1]) { ctx.beginPath(); ctx.moveTo(x, bankTop); ctx.quadraticCurveTo(x + sg * amp * 2 * (still ? 1 : 0.55 + 0.45 * ph * sg), bankTop + L / 2, x, bankTop + L); ctx.stroke(); }
    } else { ctx.beginPath(); ctx.moveTo(x, bankTop); ctx.lineTo(x, bankTop + L); ctx.strokeStyle = rgba(col.ink, 0.3 - 0.12 * sil); ctx.lineWidth = 0.6; ctx.stroke(); }
    ctx.beginPath(); ctx.arc(x, bankTop + L, 0.9, 0, 6.2832); ctx.fillStyle = rgba(col.ink, 0.4 - 0.15 * sil); ctx.fill();
  }
  // the damper
  const dy = bankTop - 9 + sil * 23, dx0 = x0 + 7 / 32 * (x1 - x0) - 4;
  ctx.beginPath(); ctx.moveTo(dx0, dy); ctx.lineTo(x1 + 4, dy); ctx.strokeStyle = rgba(col.ink, 0.55 + 0.45 * sil); ctx.lineWidth = 2.6; ctx.lineCap = "round"; ctx.stroke(); ctx.lineCap = "butt";
  ctx.beginPath(); ctx.moveTo(x1 + 4, dy); ctx.lineTo(x1 + 4, bankTop - 16); ctx.lineWidth = 0.8; ctx.strokeStyle = rgba(col.ink, 0.45); ctx.stroke();
  // step ticks
  ctx.font = `500 10px ${css("--font")}`; ctx.fillStyle = col.muted; ctx.textAlign = "center";
  const tx = n => x0 + (n - 0.5) / 32 * (x1 - x0), ty = bankTop + bankLen + 22;
  ctx.fillText("step 8", tx(8), ty); ctx.fillText("32", tx(32), ty);
}

function setState(next) {
  if (next === state) next = "rest";
  from = state; state = next; t0 = performance.now();
  bUnits.setAttribute("aria-pressed", state === "silenced"); bAtt.setAttribute("aria-pressed", state === "attention");
  line.innerHTML = LINES[state]; audioLevels();
  if (still) draw(t0); else setTimeout(() => draw(performance.now()), TW + 60);
}
bUnits.addEventListener("click", () => setState("silenced"));
bAtt.addEventListener("click", () => setState("attention"));

// pointer: pluck the fine strings, press the bank to damp it, press the pieces to exchange them
const zone = (x, y) => (x > x0 - 6 && x < x1 + 8 && y > bankTop - 16 && y < bankTop + bankLen + 8) ? "bank" : (Math.abs(x - cx) < 30 && y > yA - 22 && y < yB + 22) ? "att" : "";
const pos = e => { const r = canvas.getBoundingClientRect(); return [e.clientX - r.left, e.clientY - r.top]; };
let lastPluck = -1;
canvas.addEventListener("pointermove", e => {
  const [x, y] = pos(e), z = zone(x, y); canvas.style.cursor = z ? "pointer" : "";
  if (z !== "bank") return;
  let best = -1, bd = 7; units.forEach((u, i) => { const d = Math.abs(ux(u) - x); if (d < bd && y < bankTop + ulen(u) + 6) { bd = d; best = i; } });
  if (best >= 0 && best !== lastPluck) { units[best].pluck = 1; lastPluck = best; if (state !== "silenced") ping(best); if (still) draw(performance.now()); }
});
canvas.addEventListener("pointerdown", e => { const [x, y] = pos(e), z = zone(x, y); if (z === "bank") setState("silenced"); else if (z === "att") setState("attention"); });

// sound: two held notes whose loudness follows the two readings, and a faint shimmer from the 200
let ac = null, gA, gB, soundOn = false;
const meanOf = i => D.means[state][i];
function audioLevels() { if (!ac) return; const t = ac.currentTime, on = soundOn ? 1 : 0;
  gA.gain.setTargetAtTime(on * 0.085 * Math.max(0, meanOf(0)) / 4.46, t, 0.12); gB.gain.setTargetAtTime(on * 0.085 * Math.max(0, meanOf(1)) / 4.46, t, 0.12); }
function ping(i) { if (!ac || !soundOn) return; const o = ac.createOscillator(), g = ac.createGain(), t = ac.currentTime;
  o.frequency.value = 1174.66 * Math.pow(2, [0, 2, 4, 7, 9, 12][i % 6] / 12); g.gain.setValueAtTime(0.0001, t); g.gain.linearRampToValueAtTime(0.014, t + 0.01); g.gain.exponentialRampToValueAtTime(0.0001, t + 0.9);
  o.connect(g).connect(ac.destination); o.start(t); o.stop(t + 1); }
bSound.addEventListener("click", () => {
  soundOn = !soundOn; bSound.setAttribute("aria-pressed", soundOn);
  try {
    if (!ac) { ac = new (window.AudioContext || window.webkitAudioContext)(); const mk = f => { const o = ac.createOscillator(), g = ac.createGain(); o.type = "triangle"; o.frequency.value = f; g.gain.value = 0; o.connect(g).connect(ac.destination); o.start(); return g; }; gA = mk(293.66); gB = mk(196); }
    ac.resume(); audioLevels();
  } catch (err) { soundOn = false; bSound.setAttribute("aria-pressed", false); }
});

function frame(now) {
  if (now - lastSet > 1500) { lastSet = now; pickSet(); if (state !== "silenced") { let c = 0; units.forEach((u, i) => { if (u.to && !u.ring && c < 4) { c++; setTimeout(() => ping(i), c * 110); } }); } }
  for (const u of units) { u.ring += (u.to - u.ring) * 0.07; u.pluck *= 0.95; if (u.pluck < 0.02) u.pluck = 0; }
  draw(now); if (visible) requestAnimationFrame(frame); else running = false;
}
new ResizeObserver(layout).observe(stage);
line.innerHTML = LINES.rest; layout();
if (document.fonts && document.fonts.ready) document.fonts.ready.then(() => draw(performance.now()));
let visible = false, running = false;
new IntersectionObserver(es => { visible = es.some(e => e.isIntersecting); if (visible && !running && !still) { running = true; requestAnimationFrame(frame); } }).observe(stage);
  });
</script>
