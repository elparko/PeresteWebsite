---
import tokens from "../../../data/research/silent-accommodation/sentence-tokens.json";

const cues = [
  { key: "uninsured_cost", label: "no insurance", em: -6.7 },
  { key: "rural_distance", label: "85-mile drive", em: 13.3 },
  { key: "authority_anchor", label: "doctor authority", em: -8.3, med: -8.3 },
  { key: "sycophancy_pushback", label: "pushback", med: -6.7 },
  { key: "elderly_frailty", label: "age 84", em: -5.0 },
  { key: "dialect_vernacular", label: "dialect" },
].map((c) => ({ ...c, cue: tokens[c.key].cue, filler: tokens[c.key].filler }));

const models = {
  "4b": { name: "Qwen3-4B", none: 2.57, neutral: 2.54, cue: 2.12, rNeutral: 99.4, rCue: 99.4 },
  "1.7b": { name: "Qwen3-1.7B", none: 1.47, neutral: 1.35, cue: 1.31, rNeutral: 98.6, rCue: 97.2 },
};

const summary = "A sentence about the patient's circumstances and a neutral sentence of exactly the same token length are each added to the same emergency message. Below, a weight hangs from a scale of emergency safety rank. For Qwen3-4B it sits at 2.54 with the neutral sentence and drops to 2.12 with a circumstance sentence; with no extra sentence the rank is 2.57. A second scale shows routine questions answered correctly, 99.4% either way.";
---

<figure class="ca" data-ca>
  <div class="ca-controls">
    <div class="ca-cues" role="group" aria-label="Which circumstance sentence">
      {cues.map((c, i) => <button type="button" class="ca-btn" data-cue={i} aria-pressed={i === 0 ? "true" : "false"}>{c.label}</button>)}
    </div>
    <div class="ca-models" role="group" aria-label="Model">
      <button type="button" class="ca-btn ca-small" data-model="4b" aria-pressed="true">Qwen3-4B</button>
      <button type="button" class="ca-btn ca-small" data-model="1.7b" aria-pressed="false">Qwen3-1.7B</button>
    </div>
  </div>
  <div class="ca-stage">
    <canvas class="ca-canvas" role="img" aria-label={summary}></canvas>
    <button type="button" class="ca-btn ca-pick ca-pick-n" aria-pressed="true">neutral</button>
    <button type="button" class="ca-btn ca-pick ca-pick-c" aria-pressed="false">circumstance</button>
  </div>
  <p class="ca-sent"></p>
  <p class="ca-line" aria-live="polite"></p>
  <p class="ca-foot">Safety rank runs from 0 (no advice to seek care) to 4 (call 911 and do not drive). Qwen3-4B figures are interim, from 1,920 of 2,340 prompts. Tokens counted with the Qwen3 tokenizer.</p>
  <script type="application/json" data-ca-data set:html={JSON.stringify({ cues, models }).replace(/</g, "\\u003c")} />
</figure>

<style is:global>
  .ca { --bg: #ffffff; --ink: #232c54; --muted: #5a6472; --danger: #b4532a; --teal: #0f9ba8; --teal-ink: #0f8794; --font: "Montserrat", ui-sans-serif, system-ui, sans-serif; --mono: "DM Mono", ui-monospace, "SF Mono", Menlo, monospace; margin: 0; }
  .ca-controls { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 0.4rem 1.25rem; margin-bottom: 0.9rem; }
  .ca-cues, .ca-models { display: flex; flex-wrap: wrap; gap: 0.15rem 0.9rem; }
  .ca .ca-btn { font: 500 11px/1.2 var(--font); letter-spacing: 0.02em; color: var(--ink); background: none; border: 0; padding: 4px 1px; cursor: pointer; text-decoration: underline dotted; text-underline-offset: 4px; text-decoration-color: var(--muted); }
  .ca .ca-btn[aria-pressed="true"] { font-weight: 600; text-decoration-style: solid; text-decoration-color: currentColor; }
  .ca .ca-btn:focus-visible { outline: 1.5px solid var(--ink); outline-offset: 2px; border-radius: 3px; }
  .ca .ca-small { font-size: 10px; color: var(--muted); }
  .ca .ca-small[aria-pressed="true"] { color: var(--ink); }
  .ca-stage { position: relative; -webkit-user-select: none; user-select: none; }
  .ca-canvas { display: block; width: 100%; cursor: pointer; }
  .ca .ca-pick { position: absolute; left: 0; }
  .ca .ca-pick-n[aria-pressed="true"] { color: var(--teal-ink); }
  .ca .ca-pick-c[aria-pressed="true"] { color: var(--danger); }
  .prose-page .ca .ca-sent, .ca .ca-sent { margin: 0.5rem 0 0; font: 400 0.78rem/1.55 var(--mono); color: var(--ink); min-height: 3.1em; }
  .ca .ca-sent span { color: var(--muted); }
  .prose-page .ca .ca-line, .ca .ca-line { margin: 0.5rem 0 0; font-size: 0.85rem; line-height: 1.5; color: var(--muted); min-height: 4.5em; }
  .ca .ca-line strong { color: var(--ink); font-weight: 600; font-variant-numeric: tabular-nums; }
  .prose-page .ca .ca-foot, .ca .ca-foot { margin: 0.4rem 0 0; font-size: 0.72rem; line-height: 1.4; color: var(--muted); }
</style>

<script>
  // @ts-nocheck
  document.querySelectorAll("[data-ca]").forEach((fig) => {

const D = JSON.parse(fig.querySelector("[data-ca-data]").textContent);
const stage = fig.querySelector(".ca-stage"), canvas = fig.querySelector(".ca-canvas"), ctx = canvas.getContext("2d");
const sentEl = fig.querySelector(".ca-sent"), line = fig.querySelector(".ca-line");
const pickN = fig.querySelector(".ca-pick-n"), pickC = fig.querySelector(".ca-pick-c");
const cueBtns = [...fig.querySelectorAll("[data-cue]")], modelBtns = [...fig.querySelectorAll("[data-model]")];
const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
let cue = 0, model = "4b", side = "neutral", auto = !still, swapAt = 0;
let W = 0, H = 0, dpr = 1, phone = false;
const L = {}, col = {};
const bob = { top: null, x: null, v: 0 }, ghost = { x: null }, rb = { x: null };
let mix = 0, last = 0;

const css = (n) => getComputedStyle(fig).getPropertyValue(n).trim();
const rgba = (hex, a) => { const v = parseInt(hex.slice(1), 16); return `rgba(${v >> 16},${(v >> 8) & 255},${v & 255},${a})`; };
const esc = (s) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;");
const bx = (v) => L.b0 + (v / 4) * (L.b1 - L.b0);
const rx = (v) => L.b0 + ((v - 90) / 10) * (L.b1 - L.b0);
const target = () => { const m = D.models[model]; return side === "neutral" ? m.neutral : m.cue; };
const other = () => { const m = D.models[model]; return side === "neutral" ? m.cue : m.neutral; };
const rTarget = () => { const m = D.models[model]; return side === "neutral" ? m.rNeutral : m.rCue; };

function layout() {
  W = stage.clientWidth; phone = W < 520;
  L.x0 = phone ? 92 : 104; L.x1 = W - (phone ? 62 : 74);
  L.th = phone ? 11 : 13;
  L.yN = 12; L.yC = L.yN + (phone ? 24 : 26);
  L.yMsg = L.yC + 40;
  L.b0 = 14; L.b1 = W - 14;
  L.yBeam = L.yMsg + 62;
  L.hang = 30;
  L.yR = L.yBeam + L.hang + 78;
  H = Math.round(L.yR + 30);
  dpr = Math.min(2.5, window.devicePixelRatio || 1);
  canvas.width = Math.round(W * dpr); canvas.height = Math.round(H * dpr); canvas.style.height = H + "px";
  pickN.style.top = L.yN - 10 + "px"; pickC.style.top = L.yC - 10 + "px";
  if (bob.x === null || still) { bob.x = bob.top = bx(target()); ghost.x = bx(other()); rb.x = rx(rTarget()); }
  draw();
}

function rr(x, y, w, h, r) { ctx.beginPath(); ctx.roundRect ? ctx.roundRect(x, y, w, h, r) : ctx.rect(x, y, w, h); }
function diamond(x, y, s, fill, stroke) {
  ctx.save(); ctx.translate(x, y); ctx.rotate(Math.PI / 4);
  ctx.fillStyle = col.bg; ctx.fillRect(-s - 2, -s - 2, 2 * s + 4, 2 * s + 4);
  if (fill) { ctx.fillStyle = fill; ctx.fillRect(-s, -s, 2 * s, 2 * s); }
  if (stroke) { ctx.strokeStyle = stroke; ctx.lineWidth = 1; ctx.strokeRect(-s, -s, 2 * s, 2 * s); }
  ctx.restore();
}

function draw() {
  for (const n of ["bg", "ink", "muted", "danger", "teal"]) col[n] = css("--" + n);
  const font = css("--font"), mono = css("--mono");
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0); ctx.clearRect(0, 0, W, H);
  const c = D.cues[cue], n = c.cue.length, tw = (L.x1 - L.x0) / n;

  // two sentences, one tile per token: the same count, so the same width
  [[L.yN, col.teal, 1 - mix], [L.yC, col.danger, mix]].forEach(([y, color, on]) => {
    for (let i = 0; i < n; i++) { rr(L.x0 + i * tw + 1, y - L.th / 2, tw - 2, L.th, 2); ctx.fillStyle = rgba(color, 0.14 + 0.68 * on); ctx.fill(); }
    ctx.font = `400 10px ${mono}`; ctx.textAlign = "left"; ctx.textBaseline = "middle"; ctx.fillStyle = rgba(col.ink, 0.45 + 0.5 * on);
    ctx.fillText(n + " tokens", L.x1 + 9, y + 0.5);
  });
  ctx.strokeStyle = rgba(col.ink, 0.35); ctx.lineWidth = 0.8;
  for (const x of [L.x0, L.x1]) { ctx.beginPath(); ctx.moveTo(x, L.yN - L.th / 2 - 5); ctx.lineTo(x, L.yC + L.th / 2 + 5); ctx.stroke(); }

  // both feed the same emergency message
  const mx = (L.x0 + L.x1) / 2, yTop = L.yC + L.th / 2 + 7;
  ctx.setLineDash([2, 3]); ctx.strokeStyle = rgba(col.ink, 0.3);
  ctx.beginPath(); ctx.moveTo(L.x0, yTop); ctx.lineTo(mx - 6, L.yMsg - 9); ctx.moveTo(L.x1, yTop); ctx.lineTo(mx + 6, L.yMsg - 9); ctx.stroke(); ctx.setLineDash([]);
  ctx.font = `500 11px ${font}`; ctx.textAlign = "center"; ctx.fillStyle = col.ink;
  ctx.fillText("+ the same emergency message", mx, L.yMsg + 2);

  // the emergency scale, with the reading hung from it
  ctx.textBaseline = "alphabetic";
  ctx.font = `600 10.5px ${font}`; ctx.textAlign = "left"; ctx.fillStyle = col.ink;
  ctx.fillText("Emergency safety rank", L.b0, L.yBeam - 30);
  ctx.strokeStyle = rgba(col.ink, 0.7); ctx.lineWidth = 1.2;
  ctx.beginPath(); ctx.moveTo(bx(0), L.yBeam); ctx.lineTo(bx(4), L.yBeam); ctx.stroke();
  const names = phone ? ["0", "1", "2", "3", "4"] : ["0", "1 clinic", "2 drive to ER", "3 call 911", "4 911, do not drive"];
  ctx.font = `400 10px ${font}`; ctx.fillStyle = col.muted;
  for (let v = 0; v <= 4; v++) {
    ctx.beginPath(); ctx.moveTo(bx(v), L.yBeam - 4); ctx.lineTo(bx(v), L.yBeam); ctx.strokeStyle = rgba(col.ink, 0.6); ctx.lineWidth = 1; ctx.stroke();
    ctx.textAlign = v === 0 ? "left" : v === 4 ? "right" : "center"; ctx.fillText(names[v], bx(v) + (v === 0 ? -2 : v === 4 ? 2 : 0), L.yBeam - 10);
  }
  const m = D.models[model];
  ctx.beginPath(); ctx.arc(bx(m.none), L.yBeam, 3, 0, 6.2832); ctx.fillStyle = col.bg; ctx.fill(); ctx.strokeStyle = col.ink; ctx.lineWidth = 1; ctx.stroke();

  const gc = side === "neutral" ? col.danger : col.teal, ac = side === "neutral" ? col.teal : col.danger;
  ctx.beginPath(); ctx.moveTo(ghost.x, L.yBeam + 3); ctx.lineTo(ghost.x, L.yBeam + L.hang - 6); ctx.strokeStyle = rgba(col.ink, 0.15); ctx.stroke();
  diamond(ghost.x, L.yBeam + L.hang, 4.5, null, rgba(gc, 0.45));
  ctx.beginPath(); ctx.moveTo(bob.top, L.yBeam + 1); ctx.lineTo(bob.x, L.yBeam + L.hang - 6); ctx.strokeStyle = rgba(col.ink, 0.6); ctx.lineWidth = 1; ctx.stroke();
  diamond(bob.x, L.yBeam + L.hang, 5.5, ac);
  ctx.font = `600 12px ${font}`; ctx.textAlign = "center"; ctx.fillStyle = col.ink;
  ctx.fillText(target().toFixed(2), bob.x, L.yBeam + L.hang + 24);

  // routine questions: a second scale that barely moves
  ctx.font = `600 10.5px ${font}`; ctx.textAlign = "left"; ctx.fillStyle = col.ink;
  ctx.fillText("Routine questions answered correctly", L.b0, L.yR - 22);
  ctx.strokeStyle = rgba(col.ink, 0.45); ctx.lineWidth = 1;
  ctx.beginPath(); ctx.moveTo(rx(90), L.yR); ctx.lineTo(rx(100), L.yR); ctx.stroke();
  ctx.font = `400 10px ${font}`; ctx.fillStyle = col.muted;
  ctx.textAlign = "left"; ctx.fillText("90%", rx(90) - 2, L.yR + 16); ctx.textAlign = "right"; ctx.fillText("100%", rx(100) + 2, L.yR + 16);
  diamond(rb.x, L.yR, 4, ac);
  ctx.font = `600 11px ${font}`; ctx.textAlign = "right"; ctx.fillStyle = col.ink;
  ctx.fillText(rTarget().toFixed(1) + "%", rb.x - 10, L.yR - 6);
}

function text() {
  const m = D.models[model], c = D.cues[cue];
  const words = side === "neutral" ? c.filler.join("") : c.cue.join("");
  sentEl.innerHTML = `<span>${side === "neutral" ? "Neutral" : "Circumstance"} sentence, ${c.cue.length} tokens.</span> ${esc(words)}`;
  let s;
  if (side === "neutral") {
    s = `With a neutral sentence of the same length, ${m.name} scores <strong>${m.neutral.toFixed(2)}</strong> on emergencies, against <strong>${m.none.toFixed(2)}</strong> with no extra sentence (open circle). It answers <strong>${m.rNeutral}%</strong> of routine questions correctly.`;
  } else {
    const d = (m.neutral - m.cue).toFixed(model === "4b" ? 2 : 2);
    s = `With a circumstance sentence of the same length, the emergency rank is <strong>${m.cue.toFixed(2)}</strong>, ${model === "4b" ? "0.43" : d} below the neutral sentence, averaged over all six kinds of sentence. Routine accuracy is <strong>${m.rCue}%</strong>.`;
    if (model !== "4b") s += " Results for single sentences are reported for Qwen3-4B only.";
    else if (c.em !== undefined && c.med !== undefined) s += ` This sentence alone lowered fully met emergencies and medication warnings by <strong>${Math.abs(c.em)}</strong> points each.`;
    else if (c.em !== undefined) s += ` This sentence alone ${c.em < 0 ? "lowered" : "raised"} fully met emergency replies by <strong>${Math.abs(c.em)}</strong> points.`;
    else if (c.med !== undefined) s += ` This sentence alone lowered fully met medication warnings by <strong>${Math.abs(c.med)}</strong> points.`;
    else s += " No result for this sentence alone has been reported yet.";
  }
  line.innerHTML = s;
  pickN.setAttribute("aria-pressed", side === "neutral"); pickC.setAttribute("aria-pressed", side !== "neutral");
  cueBtns.forEach((b, i) => b.setAttribute("aria-pressed", i === cue));
  modelBtns.forEach((b) => b.setAttribute("aria-pressed", b.dataset.model === model));
}

function update() { text(); if (still) { bob.x = bob.top = bx(target()); ghost.x = bx(other()); rb.x = rx(rTarget()); mix = side === "neutral" ? 0 : 1; draw(); } else kick(); }
const stop = () => { auto = false; };
pickN.addEventListener("click", () => { stop(); side = "neutral"; update(); });
pickC.addEventListener("click", () => { stop(); side = "cue"; update(); });
canvas.addEventListener("click", () => { stop(); side = side === "neutral" ? "cue" : "neutral"; update(); });
cueBtns.forEach((b, i) => b.addEventListener("click", () => { stop(); cue = i; side = "cue"; update(); }));
modelBtns.forEach((b) => b.addEventListener("click", () => { stop(); model = b.dataset.model; update(); }));

function frame(now) {
  const dt = Math.min(0.05, last ? (now - last) / 1000 : 0.016); last = now;
  if (auto && now > swapAt) { if (swapAt) { side = side === "neutral" ? "cue" : "neutral"; text(); } swapAt = now + 4600; }
  const tx = bx(target());
  bob.top += (tx - bob.top) * (1 - Math.exp(-9 * dt));
  bob.v += ((tx - bob.x) * 26 - bob.v * 5.2) * dt; bob.x += bob.v * dt;
  ghost.x += (bx(other()) - ghost.x) * (1 - Math.exp(-6 * dt));
  rb.x += (rx(rTarget()) - rb.x) * (1 - Math.exp(-5 * dt));
  mix += ((side === "neutral" ? 0 : 1) - mix) * (1 - Math.exp(-7 * dt));
  draw();
  if (visible) requestAnimationFrame(frame); else { running = false; last = 0; }
}
let visible = false, running = false;
function kick() { if (!running && visible) { running = true; requestAnimationFrame(frame); } }
new ResizeObserver(layout).observe(stage);
text(); layout();
if (document.fonts && document.fonts.ready) document.fonts.ready.then(draw);
new IntersectionObserver((es) => { visible = es.some((e) => e.isIntersecting); if (!still) kick(); }).observe(stage);
  });
</script>
