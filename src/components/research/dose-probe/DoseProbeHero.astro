---
import data from "../../../data/research/dose-error-probe/review-flags.json";

const { about, ...flags } = data;
const families = [
  ["liver", 36, 33],
  ["drug interaction", 30, 24],
  ["kidney dose", 89, 51],
  ["kidney avoid", 30, 16],
];
const summary = "All 2,391 answers Qwen3-8B gave, one dot each, grouped on a floor by outcome: 1,035 correct, 370 underdoses or unreadable, 439 overdoses, 204 missed contraindications, 143 wrong schedules and 200 wrongly refused drugs. Each check sends its riskiest 478 answers, 20% of all, up to a review shelf. The self-check sends 277 high-harm errors and none of the wrongly refused drugs. The internal probe sends 297, including 51 wrongly refused drugs. The two combined send 301, including 29. A fourth view shows the 185 dosing rules, of which the base model already knew 124.";
---

<figure class="bm" data-bm>
  <div class="bm-controls" role="group" aria-label="Which check chooses the answers to review">
    <button type="button" class="bm-btn" data-k="self" aria-pressed="false">self-check</button>
    <button type="button" class="bm-btn" data-k="probe" aria-pressed="false">internal probe</button>
    <button type="button" class="bm-btn" data-k="combo" aria-pressed="false">probe + self-check</button>
    <button type="button" class="bm-btn bm-quiet" data-k="base" aria-pressed="false">rules in the base model</button>
  </div>
  <div class="bm-stage">
    <canvas class="bm-canvas" role="img" aria-label={summary}></canvas>
  </div>
  <p class="bm-line" aria-live="polite"></p>
  <p class="bm-foot">Qwen3-8B, 2,391 answers graded on the strict schedule. Each dot is one answer; the raised dots are the actual answers each check ranked riskiest.</p>
  <script type="application/json" data-bm-data set:html={JSON.stringify({ ...flags, families })} />
</figure>

<style is:global>
  .bm { --bg: #ffffff; --ink: #232c54; --muted: #5a6472; --danger: #b4532a; --teal: #0f9ba8; --font: "Montserrat", ui-sans-serif, system-ui, sans-serif; margin: 0; }
  .bm-controls { display: flex; flex-wrap: wrap; gap: 0.15rem 1rem; margin-bottom: 0.4rem; }
  .bm .bm-btn { font: 500 11px/1.2 var(--font); letter-spacing: 0.02em; color: var(--ink); background: none; border: 0; padding: 4px 1px; cursor: pointer; text-decoration: underline dotted; text-underline-offset: 4px; text-decoration-color: var(--muted); }
  .bm .bm-btn[aria-pressed="true"] { font-weight: 600; text-decoration-style: solid; text-decoration-color: currentColor; }
  .bm .bm-btn:focus-visible { outline: 1.5px solid var(--ink); outline-offset: 2px; border-radius: 3px; }
  .bm .bm-quiet { color: var(--muted); margin-left: auto; }
  .bm .bm-quiet[aria-pressed="true"] { color: var(--ink); }
  .bm-stage { position: relative; touch-action: pan-y; -webkit-user-select: none; user-select: none; }
  .bm-canvas { display: block; width: 100%; cursor: default; }
  .prose-page .bm .bm-line, .bm .bm-line { margin: 0.5rem 0 0; font-size: 0.85rem; line-height: 1.5; color: var(--muted); min-height: 4.5em; }
  .bm .bm-line strong { color: var(--ink); font-weight: 600; font-variant-numeric: tabular-nums; }
  .prose-page .bm .bm-foot, .bm .bm-foot { margin: 0.4rem 0 0; font-size: 0.72rem; line-height: 1.4; color: var(--muted); }
</style>

<script>
  // @ts-nocheck
  document.querySelectorAll("[data-bm]").forEach((fig) => {

const D = JSON.parse(fig.querySelector("[data-bm-data]").textContent);
const stage = fig.querySelector(".bm-stage"), canvas = fig.querySelector(".bm-canvas"), ctx = canvas.getContext("2d");
const line = fig.querySelector(".bm-line"), btns = [...fig.querySelectorAll("[data-k]")];
const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
const BIT = { self: 1, probe: 2, combo: 4 };
const ZONES = [
  { c: "o", name: "correct", short: "correct", harm: false },
  { c: "u", name: "underdose or unreadable", short: "under", harm: false },
  { c: "v", name: "overdose", short: "over", harm: true },
  { c: "f", name: "missed contraindication", short: "missed", harm: true },
  { c: "s", name: "wrong schedule", short: "schedule", harm: true },
  { c: "w", name: "wrongly refused", short: "refused", harm: true, wa: true },
];
const LINES = {
  rest: "Every answer the model gave, grouped by outcome. <strong>986</strong> are high-harm errors, including <strong>200</strong> drugs it wrongly refused. A reviewer can read the riskiest 20%, <strong>478</strong> answers. Choose a check to see which ones it sends.",
  self: "The self-check sends <strong>277</strong> high-harm errors to review (<strong>28.1%</strong>) and <strong>94</strong> correct answers. It sends <strong>none</strong> of the 200 wrongly refused drugs: on those refusals it scores <strong>0.399</strong>, worse than a coin flip.",
  probe: "The internal probe, read after the answer, sends <strong>297</strong> high-harm errors (<strong>30.1%</strong>), including <strong>51</strong> of the 200 wrongly refused drugs, which it scores <strong>0.743</strong>. It sends only 14 of 143 wrong schedules, against 55 for the self-check.",
  combo: "Probe and self-check together send <strong>301</strong> high-harm errors (<strong>30.5%</strong>), the most of any check, and <strong>29</strong> wrongly refused drugs. Overall score <strong>0.753</strong>, the highest.",
  base: "Asked closed-book, the base model before chat tuning already favored the adjusted regimen for <strong>124 of 185</strong> rules (67.0%): 33 of 36 liver rules, 24 of 30 drug interactions, 51 of 89 kidney dose reductions and 16 of 30 kidney contraindications.",
};
const ROWS = 26, GAP = 2.2, DEEP0 = 0.26, TILT = 0.5, YAW0 = -0.2, SWEEP = 1800, CYCLE = 6500;
let state = "rest", sweepT0 = -1e9, morph = 0, morphTo = 0, auto = !still, nextAt = 0, autoI = 0;
let W = 0, H = 0, dpr = 1, cx = 0, scale = 1, yFloor = 0, lift = 70, phone = false, famRows = [], DEEP = DEEP0;
let yaw = YAW0, yawTo = YAW0, sway = 0, co = 1, si = 0, drag = false, lastX = 0, inside = false;
const col = {};

// lay out every answer in its zone: columns of ROWS dots, zones side by side
const dots = [];
const byZone = ZONES.map((z) => []);
for (let i = 0; i < D.cats.length; i++) { const zi = ZONES.findIndex((z) => z.c === D.cats[i]); byZone[zi].push(i); }
const cols = byZone.map((a) => Math.ceil(a.length / ROWS));
const totalCols = cols.reduce((a, b) => a + b, 0) + GAP * (ZONES.length - 1);
const dx = 2 / totalCols; DEEP = (ROWS * dx) / 2;
let c0 = 0;
ZONES.forEach((z, zi) => {
  z.x0 = -1 + c0 * dx; z.x1 = z.x0 + cols[zi] * dx; z.n = byZone[zi].length;
  const h = (k) => { const v = Math.sin(k * 12.9898 + zi * 78.233) * 43758.5453; return v - Math.floor(v); };
  byZone[zi].forEach((i, k) => {
    const cc = Math.floor(k / ROWS), rr = k % ROWS;
    dots.push({ i, z: zi, wx: z.x0 + (cc + 0.5 + (h(k) - 0.5) * 0.35) * dx, wz: -DEEP + (rr + 0.5 + (h(k + 7) - 0.5) * 0.35) * dx, f: +D.flags[i], up: 0, ph: h(k + 3) * 6.283 });
  });
  c0 += cols[zi] + GAP;
});
const pills = [];
D.families.forEach((f, fi) => { for (let i = 0; i < f[1]; i++) { const d = dots[Math.floor(((pills.length + 0.5) * dots.length) / 185)]; const p = { d, fi, i, known: i < f[2] }; d.pill = p; pills.push(p); } });

const css = (n) => getComputedStyle(fig).getPropertyValue(n).trim();
const rgba = (hex, a) => { const v = parseInt(hex.slice(1), 16); return `rgba(${v >> 16},${(v >> 8) & 255},${v & 255},${a})`; };
const ease = (p) => 1 - Math.pow(1 - Math.min(1, Math.max(0, p)), 3);
const clamp = (v, a, b) => (v < a ? a : v > b ? b : v);
const PX = (x, z) => cx + (x * co - z * si) * scale, PY = (x, z, h) => yFloor + (x * si + z * co) * scale * TILT - (h || 0);

function layout() {
  W = stage.clientWidth; phone = W < 520;
  cx = W / 2; scale = (W - 8) / 2 / 1.05; lift = phone ? 56 : 74;
  const pad = (Math.sin(0.45) + DEEP) * scale * TILT;
  yFloor = 30 + lift + pad;
  const fieldH = yFloor + pad + (phone ? 74 : 82);
  const pw = phone ? 4 : 5, gap = phone ? 2.5 : 3, ph = phone ? 11 : 13, lab = phone ? 0 : 150;
  const per = Math.max(10, Math.floor((W - lab - 4) / (pw + gap)));
  let y = 0; famRows = [];
  D.families.forEach((f, fi) => {
    if (phone) y += 16;
    famRows.push({ f, y });
    pills.filter((p) => p.fi === fi).forEach((p) => { const r = Math.floor(p.i / per), c = p.i % per; p.px = lab + c * (pw + gap) + pw / 2; p.py = y + r * (ph + 5) + ph / 2; });
    y += Math.ceil(f[1] / per) * (ph + 5) + (phone ? 10 : 16);
  });
  famRows.pw = pw; famRows.ph = ph;
  H = Math.round(Math.max(fieldH, y + 20));
  const off = (H - y) / 2;
  pills.forEach((p) => (p.py += off)); famRows.forEach((r) => (r.y += off));
  dpr = Math.min(2.5, window.devicePixelRatio || 1);
  canvas.width = Math.round(W * dpr); canvas.height = Math.round(H * dpr); canvas.style.height = H + "px";
  draw(performance.now());
}

function quad(xa, xb, h) { ctx.beginPath(); [[xa, -DEEP], [xb, -DEEP], [xb, DEEP], [xa, DEEP]].forEach(([x, z], i) => (i ? ctx.lineTo(PX(x, z), PY(x, z, h)) : ctx.moveTo(PX(x, z), PY(x, z, h)))); ctx.closePath(); }

function draw(now) {
  for (const n of ["bg", "ink", "muted", "danger", "teal"]) col[n] = css("--" + n);
  const font = css("--font");
  co = Math.cos(yaw); si = Math.sin(yaw);
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0); ctx.clearRect(0, 0, W, H);
  const b = still ? morphTo : ease(morph), a = 1 - b;
  const bit = BIT[state] || 0, sp = still ? 2 : (now - sweepT0) / SWEEP, sx = -1.05 + 2.1 * sp;
  const front = co >= 0 ? DEEP : -DEEP, t = now / 1000;

  if (a > 0) {
    ctx.globalAlpha = a;
    // the floor: one outline per zone
    ZONES.forEach((z) => { quad(z.x0 - dx * 0.4, z.x1 + dx * 0.4, 0); if (z.wa) { ctx.setLineDash([2, 3]); ctx.strokeStyle = rgba(col.danger, 0.5); } else ctx.strokeStyle = rgba(col.ink, z.harm ? 0.3 : 0.14); ctx.lineWidth = 0.8; ctx.stroke(); ctx.setLineDash([]); });
    // the review shelf
    const shelfOn = dots.some((d) => d.up > 0.05);
    quad(-1.02, 1.02, lift); ctx.fillStyle = rgba(col.teal, shelfOn ? 0.05 : 0.02); ctx.fill(); ctx.strokeStyle = rgba(col.ink, shelfOn ? 0.28 : 0.12); ctx.lineWidth = 0.8; ctx.stroke();
    ctx.globalAlpha = 1;
  }

  // floor dots first, then stems and raised dots on top
  const raised = [];
  for (const d of dots) {
    const on = bit && (d.f & bit) && (sp > 1 || sx > d.wx);
    d.up += ((on ? 1 : 0) - d.up) * (still ? 1 : 0.09);
    const z = ZONES[d.z], fx = PX(d.wx, d.wz), fy = PY(d.wx, d.wz, 0);
    if (d.pill && b > 0) {
      const p = d.pill, x = fx + (p.px - fx) * b, y = fy + (p.py - fy) * b, w = 2.4 + (famRows.pw - 2.4) * b, h = 2.4 + (famRows.ph - 2.4) * b;
      ctx.beginPath(); ctx.roundRect ? ctx.roundRect(x - w / 2, y - h / 2, w, h, Math.min(w, h) / 2) : ctx.rect(x - w / 2, y - h / 2, w, h);
      if (p.known && b > 0.5) { ctx.fillStyle = rgba(col.teal, 0.25 + 0.7 * b); ctx.fill(); }
      else { ctx.fillStyle = rgba(col.ink, 0.12 * a); ctx.fill(); ctx.strokeStyle = rgba(col.ink, 0.3 * b); ctx.lineWidth = 0.8; ctx.stroke(); }
      continue;
    }
    if (a <= 0) continue;
    if (d.up > 0.02) { raised.push(d); continue; }
    ctx.globalAlpha = a;
    if (z.wa) { ctx.beginPath(); ctx.arc(fx, fy, 1.5, 0, 6.2832); ctx.strokeStyle = rgba(col.danger, 0.75); ctx.lineWidth = 0.8; ctx.stroke(); }
    else { ctx.fillStyle = rgba(z.harm ? col.danger : col.ink, z.harm ? 0.42 : 0.2); ctx.fillRect(fx - 1.1, fy - 1.1, 2.2, 2.2); }
  }
  raised.sort((p, q) => PY(p.wx, p.wz) - PY(q.wx, q.wz));
  for (const d of raised) {
    const z = ZONES[d.z], h = ease(d.up) * (lift + (still ? 0 : 1.6 * Math.sin(t * 1.3 + d.ph))), x = PX(d.wx, d.wz), y0 = PY(d.wx, d.wz, 0), y1 = y0 - h;
    const c = z.harm ? col.teal : col.ink;
    ctx.globalAlpha = a;
    ctx.beginPath(); ctx.moveTo(x, y0); ctx.lineTo(x, y1); ctx.strokeStyle = rgba(c, 0.16); ctx.lineWidth = 0.6; ctx.stroke();
    ctx.beginPath(); ctx.arc(x, y1, z.harm ? 1.9 : 1.6, 0, 6.2832); ctx.fillStyle = rgba(c, z.harm ? 0.95 : 0.55); ctx.fill();
  }
  ctx.globalAlpha = 1;

  // the sweep: a thin wall of light crossing the floor as the check ranks each answer
  if (bit && sp > 0 && sp < 1.05 && b < 0.05) {
    const x = clamp(sx, -1.02, 1.02);
    ctx.beginPath(); ctx.moveTo(PX(x, -DEEP), PY(x, -DEEP, 0)); ctx.lineTo(PX(x, DEEP), PY(x, DEEP, 0)); ctx.lineTo(PX(x, DEEP), PY(x, DEEP, lift)); ctx.lineTo(PX(x, -DEEP), PY(x, -DEEP, lift)); ctx.closePath();
    ctx.fillStyle = rgba(col.teal, 0.07); ctx.fill(); ctx.strokeStyle = rgba(col.teal, 0.5); ctx.lineWidth = 0.8; ctx.stroke();
  }

  if (a > 0.05) {
    ctx.globalAlpha = Math.min(1, a * 1.4); ctx.textBaseline = "alphabetic";
    // shelf label
    ctx.font = `500 10.5px ${font}`; ctx.textAlign = "left"; ctx.fillStyle = col.muted;
    const sl = PY(-1, -DEEP, lift) < PY(-1, DEEP, lift) ? -DEEP : DEEP;
    const shelfText = phone ? "sent to a reviewer, 478 answers" : "sent to a reviewer: the riskiest 478 answers (20%)";
    ctx.lineWidth = 4; ctx.strokeStyle = col.bg; ctx.lineJoin = "round";
    ctx.strokeText(shelfText, Math.max(2, PX(-1, sl)), PY(-1, sl, lift) - 14); ctx.fillText(shelfText, Math.max(2, PX(-1, sl)), PY(-1, sl, lift) - 14);
    // zone labels along the front edge, in two tiers so narrow zones do not collide
    const TIER = [0, 1, 0, 2, 1, 0];
    ZONES.forEach((z, zi) => {
      const label = phone ? z.short : z.name;
      ctx.font = `500 ${phone ? 9.5 : 10.5}px ${font}`;
      const hw = ctx.measureText(label).width / 2 + 2, xm = (z.x0 + z.x1) / 2, X = clamp(PX(xm, front), hw, W - hw), Y = PY(xm, front, 0) + 16 + TIER[zi] * 25;
      const sent = bit ? dots.filter((d) => d.z === zi && d.up > 0.5).length : null;
      ctx.textAlign = "center"; ctx.fillStyle = z.wa ? col.danger : z.harm ? col.ink : col.muted;
      ctx.fillText(label, X, Y);
      ctx.font = `400 ${phone ? 9 : 10}px ${font}`; ctx.fillStyle = col.muted;
      ctx.fillText(sent === null ? z.n.toLocaleString("en-US") : `${sent} of ${z.n.toLocaleString("en-US")}`, X, Y + 11);
    });
    ctx.globalAlpha = 1;
  }
  if (b > 0.4) {
    ctx.globalAlpha = (b - 0.4) / 0.6; ctx.textBaseline = "alphabetic"; ctx.textAlign = "left";
    famRows.forEach(({ f, y }) => {
      const ty = phone ? y - 6 : y + famRows.ph / 2 + 4;
      ctx.font = `500 11px ${font}`; ctx.fillStyle = col.ink; ctx.fillText(f[0], 0, ty);
      const w = ctx.measureText(f[0]).width; ctx.fillStyle = col.muted; ctx.font = `400 10.5px ${font}`;
      ctx.fillText(`${f[2]} of ${f[1]}`, w + 8, ty);
    });
    ctx.globalAlpha = 1;
  }
}

function setState(next, fromUser) {
  if (fromUser) auto = false;
  if (next === state && fromUser) next = "rest";
  state = next; sweepT0 = performance.now(); morphTo = state === "base" ? 1 : 0;
  btns.forEach((b) => b.setAttribute("aria-pressed", b.dataset.k === state));
  line.innerHTML = LINES[state];
  if (still) draw(performance.now());
}
btns.forEach((b) => b.addEventListener("click", () => setState(b.dataset.k, true)));

const pos = (e) => { const r = canvas.getBoundingClientRect(); return e.clientX - r.left; };

const ORDER = ["self", "probe", "combo"];
let last = 0;
function frame(now) {
  const dt = Math.min(0.05, last ? (now - last) / 1000 : 0.016); last = now;
  if (auto && now > nextAt) { if (nextAt) { setState(ORDER[autoI % 3]); autoI++; } nextAt = now + (nextAt ? CYCLE : 2200); }
  morph += (morphTo - morph) * (1 - Math.exp(-dt * 3.3));
  if (Math.abs(morphTo - morph) < 0.002) morph = morphTo;
  if (!inside && !drag) sway += dt;
  yaw = YAW0;
  draw(now);
  if (visible) requestAnimationFrame(frame); else { running = false; last = 0; }
}
let visible = false, running = false;
new ResizeObserver(layout).observe(stage);
line.innerHTML = LINES.rest; layout();
if (document.fonts && document.fonts.ready) document.fonts.ready.then(() => draw(performance.now()));
new IntersectionObserver((es) => { visible = es.some((e) => e.isIntersecting); if (visible && !running && !still) { running = true; requestAnimationFrame(frame); } }).observe(stage);
  });
</script>
