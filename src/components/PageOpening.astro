---
/* The opening every main page shares with the research posts: words on the
   left, one large figure on the right, stacked on narrow screens. */
interface Props {
  label?: string;
  title: string;
  tone?: "light" | "dark";
}
const { label, title, tone = "light" } = Astro.props;
const hasFigure = Astro.slots.has("figure");
const hasLinks = Astro.slots.has("links");
---

<section class:list={["page-opening", `po-${tone}`, hasFigure && "has-figure"]}>
  <div class="container-page">
    <div class="po-grid">
      <div class="po-head">
        {label && <p class="label-mono mb-5">{label}</p>}
        <h1>{title}</h1>
      </div>
      {hasFigure && (
        <div class="po-figure">
          <slot name="figure" />
        </div>
      )}
      <div class="po-meta">
        <slot />
      </div>
      {hasLinks && (
        <div class="po-links">
          <slot name="links" />
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .page-opening {
    padding-top: clamp(3rem, 2rem + 5vw, 6rem);
    padding-bottom: clamp(3rem, 2rem + 4vw, 5.5rem);
  }
  .po-dark {
    background: theme("colors.brand.ink");
    color: #fff;
  }
  .po-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.75rem;
  }
  .po-head h1 {
    font-size: clamp(2.25rem, 1.4rem + 3.2vw, 3.6rem);
    line-height: 1.04;
  }
  .po-meta :global(p) {
    max-width: 34rem;
    font-size: clamp(1.05rem, 1rem + 0.3vw, 1.25rem);
    line-height: 1.55;
    color: rgb(35 44 84 / 0.82);
  }
  .po-dark .po-meta :global(p) {
    color: rgb(255 255 255 / 0.82);
  }
  .po-meta :global(p + p) {
    margin-top: 0.9rem;
  }
  .po-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }
  @media (min-width: 1024px) {
    .has-figure .po-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      grid-template-rows: auto auto 1fr;
      column-gap: clamp(2.5rem, 5vw, 4.5rem);
      row-gap: 1.75rem;
      align-items: start;
    }
    .has-figure .po-head {
      grid-column: 1;
      grid-row: 1;
    }
    .has-figure .po-meta {
      grid-column: 1;
      grid-row: 2;
    }
    .has-figure .po-links {
      grid-column: 1;
      grid-row: 3;
    }
    .has-figure .po-figure {
      grid-column: 2;
      grid-row: 1 / span 3;
      align-self: center;
    }
  }
</style>
