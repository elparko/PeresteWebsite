---
import { conditions } from "../data/conditions";
---

<ul class="flex flex-wrap gap-2.5" aria-label="Chronic conditions Guide covers">
  {
    conditions.map((c, i) => (
      <li
        class={`inline-flex items-baseline gap-2 rounded-full border px-4 py-2 ${
          c.lead
            ? "border-brand-accent/70 bg-brand-accent-soft"
            : "border-brand-line bg-brand-surface"
        }`}
        data-reveal
        style={`--reveal-delay:${i * 40}ms`}
      >
        <span class="text-sm font-medium text-brand-ink">{c.label}</span>
        {c.abbr && <span class="text-xs text-brand-muted">{c.abbr}</span>}
        {c.lead && (
          <span class="text-[0.6rem] font-semibold uppercase tracking-[0.14em] text-brand-accent">
            Lead
          </span>
        )}
      </li>
    ))
  }
</ul>
