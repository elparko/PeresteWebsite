---
import { conditions } from "../data/conditions";
---

<ul class="flex flex-wrap gap-2.5" aria-label="Chronic conditions HearthAI supports">
  {
    conditions.map((c) => (
      <li class="inline-flex items-baseline gap-2 rounded-full border border-brand-line bg-brand-surface px-4 py-2">
        <span class="text-sm font-medium text-brand-ink">{c.label}</span>
        {c.abbr && <span class="text-xs text-brand-muted">{c.abbr}</span>}
      </li>
    ))
  }
</ul>
