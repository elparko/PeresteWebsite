---
import Base from "../layouts/Base.astro";
import PageOpening from "../components/PageOpening.astro";
import GlyphArt from "../components/GlyphArt.astro";

const practices = [
  {
    label: "Educates, does not advise",
    line: "Guide explains a patient's own records and does not give medical advice. When something sounds urgent, it sends the patient to a person.",
  },
  {
    label: "Through clinics",
    line: "Guide is being built for clinics to offer to their patients. It will not be sold directly to consumers.",
  },
  {
    label: "Published research",
    line: "Each study is published with its methods and results.",
  },
];
---

<Base
  title="About · Pereste Health"
  description="Pereste Health Inc. is a Louisiana company that builds Pereste Guide, a voice app in development that explains a patient's own health record in plain language, and publishes safety research on healthcare AI."
>
  <PageOpening label="About" title="Pereste Health builds Pereste Guide and publishes safety research on healthcare AI.">
    <p>Pereste Health Inc. is a Louisiana company.</p>
    <p>Pereste Guide is in development. Each study is published here with its methods and results.</p>
    <div slot="figure" class="about-figure">
      <GlyphArt
        piece="name-field"
        label="Rows of the word Pereste, with two cones of brighter letters forming a lighthouse's twin beams."
        class="about-glyph"
        ground={true}
      />
    </div>
    <Fragment slot="links">
      <a href="mailto:parker@pereste.com" class="btn-primary">Contact</a>
    </Fragment>
  </PageOpening>

  <section class="lines" aria-labelledby="two-lines">
    <div class="container-page">
      <h2 id="two-lines">Two lines of work</h2>
      <div class="lines-grid">
        <div class="line-col">
          <p class="label-mono">Guide · for patients</p>
          <p>
            Guide is a voice app that reads a patient's own discharge papers, lab results and care plan and
            explains them out loud in plain language. It covers six chronic conditions, with type 2 diabetes
            as the lead.
          </p>
          <a href="/guide/" class="link-arrow">See Guide</a>
        </div>
        <div class="line-col">
          <p class="label-mono">Research · on models</p>
          <p>
            We study how language models handle medications and medical advice, in openly released models and
            in Claude. The published work is a medication neuron atlas of Qwen3-8B, the DoseGate output
            layer, and a study of advice versus education in Qwen3.5-4B.
          </p>
          <a href="/research/" class="link-arrow">Read the research</a>
        </div>
      </div>
    </div>
  </section>

  <section class="practice" aria-labelledby="how-we-work">
    <div class="container-page">
      <div class="practice-grid">
        <h2 id="how-we-work">How we work</h2>
        <dl class="practice-list">
          {practices.map((p) => (
            <div>
              <dt class="label-mono">{p.label}</dt>
              <dd>{p.line}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <section class="people" aria-labelledby="people">
    <div class="container-page">
      <div class="people-grid">
        <div>
          <h2 id="people">People</h2>
          <ul class="team">
            <li>
              <p class="person">Parker Smith</p>
              <p class="label-mono">Founder, chief executive officer</p>
            </li>
            <li>
              <p class="person">Drew Mouton</p>
              <p class="label-mono">Co-founder, chief business officer</p>
            </li>
            <li>
              <p class="person">Ranjith Kumar</p>
              <p class="label-mono">Co-founder, chief technology officer</p>
            </li>
          </ul>
        </div>
        <div>
          <h2 class="facts-head">Company facts</h2>
          <dl class="facts">
            <div>
              <dt class="label-mono">Legal name</dt>
              <dd>Pereste Health Inc.</dd>
            </div>
            <div>
              <dt class="label-mono">Based in</dt>
              <dd>Louisiana, USA</dd>
            </div>
            <div>
              <dt class="label-mono">Contact</dt>
              <dd><a href="mailto:parker@pereste.com">parker@pereste.com</a></dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .team {
    display: grid;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }
  .team .label-mono {
    margin-top: 0.25rem;
  }
  .about-figure {
    min-width: 0;
  }
  .about-figure :global(.about-glyph) {
    aspect-ratio: 8 / 7;
    border-radius: 1.25rem;
  }

  .lines {
    padding-block: clamp(3.5rem, 2.5rem + 4vw, 6rem);
    background: #f6f8fa;
    border-top: 1px solid theme("colors.brand.line");
  }
  .lines-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    margin-top: 2.5rem;
  }
  .line-col {
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.75rem;
    border-radius: 1.25rem;
    border: 1px solid theme("colors.brand.line");
    background: #fff;
  }
  .line-col p:not(.label-mono) {
    max-width: 34rem;
    color: rgb(35 44 84 / 0.85);
  }
  .line-col .link-arrow {
    margin-top: auto;
  }
  @media (min-width: 768px) {
    .lines-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .line-col {
      padding: 2.25rem;
    }
  }

  .practice {
    padding-block: clamp(3.5rem, 2.5rem + 4vw, 6rem);
    background: theme("colors.brand.ink");
    color: #fff;
  }
  .practice .label-mono {
    color: theme("colors.brand.teal-pale");
  }
  .practice-grid {
    display: grid;
    gap: 2.5rem;
  }
  .practice-grid > * {
    min-width: 0;
  }
  .practice-list {
    display: grid;
    gap: 1.75rem;
  }
  .practice-list dd {
    margin-top: 0.4rem;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: rgb(255 255 255 / 0.85);
  }
  @media (min-width: 900px) {
    .practice-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 4rem;
    }
  }

  .people {
    padding-block: clamp(3.5rem, 2.5rem + 4vw, 6rem);
  }
  .people-grid {
    display: grid;
    gap: 3.5rem;
  }
  .people-grid > * {
    min-width: 0;
  }
  .person {
    margin-top: 0.5rem;
    font-family: theme("fontFamily.display");
    font-weight: 700;
    font-size: 1.5rem;
  }
  .facts {
    display: grid;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }
  .facts dd {
    margin-top: 0.3rem;
    font-size: 1.0625rem;
    overflow-wrap: anywhere;
  }
  .facts a {
    text-decoration: underline;
    text-decoration-color: theme("colors.brand.line");
    text-underline-offset: 4px;
  }
  @media (hover: hover) and (pointer: fine) {
    .facts a:hover {
      text-decoration-color: theme("colors.brand.ink");
    }
  }
  @media (min-width: 900px) {
    .people-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 4rem;
    }
  }
</style>
