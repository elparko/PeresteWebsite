---
import Base from "../layouts/Base.astro";
import PageOpening from "../components/PageOpening.astro";
import ConditionChips from "../components/ConditionChips.astro";

const screens = [
  {
    src: "/images/app-labs.png",
    alt: "The Guide labs screen, showing A1C and both blood pressure numbers, each on a range bar with a short plain-language note.",
    label: "Labs",
    body: "It shows A1C, blood pressure and the other results on a range, with a plain-language note on each one.",
  },
  {
    src: "/images/app-medicines.png",
    alt: "The Guide medicines screen, listing each medicine with what it is for.",
    label: "Medicines",
    body: "It explains what each medicine is for and when to take it, in everyday words instead of the label's.",
  },
  {
    src: "/images/app-visits.png",
    alt: "The Guide visits screen, showing the next appointment with its reason, doctor and clinic.",
    label: "Visits",
    body: "It lists the coming visits, says why each one matters, and helps the patient prepare questions.",
  },
];
---

<Base
  title="Pereste Guide · Pereste Health"
  description="Pereste Guide is a voice app, in development, that reads a patient's own discharge papers, lab results and care plan and explains them out loud in plain language. It does not give medical advice."
>
  <PageOpening label="Pereste Guide" title="Your care, explained out loud.">
    <p>
      Pereste Guide reads a patient's own discharge papers, lab results and care plan, and explains them out
      loud in plain language. It does not give medical advice. When something sounds urgent, it sends
      the patient to a person.
    </p>
    <p>Guide is in development. It is not yet in use with patients.</p>
    <div slot="figure" class="stage">
      <div class="phone">
        <div class="device">
          <img
            src="/images/app-home.png"
            alt="The Guide app's home screen, showing a patient's own A1C result and an upcoming eye exam."
            width="720"
            height="1558"
            loading="eager"
            decoding="async"
          />
        </div>
        <span class="pin pin-a">own records</span>
        <span class="pin pin-b">plain words, out loud</span>
        <span class="pin pin-c">urgent goes to a person</span>
      </div>
    </div>
    <a slot="links" href="mailto:parker@pereste.com" class="btn-primary">Ask about Guide</a>
  </PageOpening>

  <section class="band band-tint">
    <div class="container-page">
      <p class="label-mono mb-4">What it does</p>
      <h2>Three screens, one patient's record.</h2>
      <ul class="screens">
        {screens.map((s) => (
          <li>
            <div class="screen-frame">
              <div class="device device-sm">
                <img src={s.src} alt={s.alt} width="720" height="1558" loading="lazy" decoding="async" />
              </div>
            </div>
            <p class="label-mono mt-6 mb-2">{s.label}</p>
            <p class="screen-body">{s.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="conditions" class="band">
    <div class="container-page split-grid">
      <div>
        <p class="label-mono mb-4">Six chronic conditions</p>
        <h2>Type 2 diabetes first.</h2>
      </div>
      <div class="col">
        <ConditionChips />
        <p class="body">
          Guide covers six chronic conditions, and type 2 diabetes is the lead condition.
        </p>
      </div>
    </div>
  </section>

  <section class="band band-tint" aria-labelledby="why">
    <div class="container-page split-grid">
      <div>
        <p class="label-mono mb-4">Why plain language</p>
        <h2 id="why">Health literacy in the United States.</h2>
      </div>
      <dl class="rows rows-light">
        <div>
          <dt class="label-mono">About 90 million</dt>
          <dd>
            Americans have literacy skills insufficient for today's healthcare settings.
            <span class="source">Source: JAMA</span>
          </dd>
        </div>
        <div>
          <dt class="label-mono">36%</dt>
          <dd>
            of U.S. adults have basic or below-basic health literacy. Among adults 65 and older, the
            figure is 59%.
            <span class="source">Source: AHA Scientific Statement</span>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="band band-ink">
    <div class="container-page split-grid">
      <div>
        <p class="label-mono mb-4">Limits</p>
        <h2>What Guide does not do.</h2>
      </div>
      <dl class="rows">
        <div>
          <dt class="label-mono">No diagnosis</dt>
          <dd>Guide does not diagnose, create a treatment plan or change the care team's instructions.</dd>
        </div>
        <div>
          <dt class="label-mono">Care team decides</dt>
          <dd>Decisions about care stay with the patient and their physician.</dd>
        </div>
        <div>
          <dt class="label-mono">Emergencies</dt>
          <dd>In an emergency, the patient should call 911 or go to the nearest emergency department, not use Guide.</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="band">
    <div class="container-page split-grid">
      <div>
        <p class="label-mono mb-4">Access</p>
        <h2>How it will reach patients.</h2>
      </div>
      <dl class="rows rows-light">
        <div>
          <dt class="label-mono">Enrollment</dt>
          <dd>Patients will enroll through a participating clinic. Guide is not sold directly to consumers.</dd>
        </div>
        <div>
          <dt class="label-mono">Status</dt>
          <dd>Guide is in development. It is not yet in use with patients.</dd>
        </div>
        <div>
          <dt class="label-mono">Apps</dt>
          <dd>Guide is not yet on the App Store or Google Play. It is planned for both.</dd>
        </div>
        <div>
          <dt class="label-mono">Deployment</dt>
          <dd>Guide is being built with flexible deployment options.</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="band band-tint">
    <div class="container-page split-grid">
      <div>
        <p class="label-mono mb-4">Research</p>
        <h2>Related research.</h2>
      </div>
      <div class="col">
        <ul class="studies">
          <li>
            <a href="/research/advice-vs-education/" class="link-arrow">Advice versus education</a>
            <p>A study of whether a chat model's internal state separates a request for medical advice from a request for medical education.</p>
          </li>
          <li>
            <a href="/research/dosegate/" class="link-arrow">DoseGate</a>
            <p>An output layer that fills every medication reference from the patient's medication orders or blocks the output.</p>
          </li>
        </ul>
        <p class="body">This research and Guide come from the same group. The research is meant to inform how Guide is built.</p>
        <a href="/research/" class="link-arrow">All research</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .source {
    display: block;
    margin-top: 0.35rem;
    font-size: 0.8125rem;
    color: theme("colors.brand.muted");
  }
  .stage {
    display: grid;
    place-items: center;
    padding-block: 0.5rem;
  }
  .phone {
    position: relative;
    width: min(60%, 18rem);
  }
  .pin {
    position: absolute;
    white-space: nowrap;
    font-family: theme("fontFamily.mono");
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.4rem 0.55rem;
    border-radius: 3px;
    background: theme("colors.brand.ink");
    color: #fff;
    box-shadow: 0 6px 16px -8px rgba(35, 44, 84, 0.5);
  }
  .pin-a {
    top: 16%;
    right: calc(100% - 1.25rem);
  }
  .pin-b {
    top: 46%;
    left: calc(100% - 1.25rem);
    background: theme("colors.brand.accent-soft");
    color: #0a6f79;
    box-shadow: inset 0 0 0 1px theme("colors.brand.accent");
  }
  .pin-c {
    bottom: 14%;
    right: calc(100% - 1.25rem);
  }
  @media (max-width: 1199px) {
    .pin-a,
    .pin-c {
      right: auto;
      left: -3.25rem;
    }
    .pin-b {
      left: auto;
      right: -3.25rem;
    }
  }
  @media (max-width: 639px) {
    .pin {
      font-size: 0.62rem;
      padding: 0.3rem 0.4rem;
    }
  }

  .band {
    padding-block: clamp(4rem, 3rem + 5vw, 7rem);
  }
  .band h2 {
    max-width: 18ch;
  }
  .band-tint {
    background: #f6f8fa;
  }
  .band-ink {
    background: theme("colors.brand.ink");
    color: #fff;
  }
  .band-ink .label-mono {
    color: theme("colors.brand.teal-pale");
  }

  .split-grid {
    display: grid;
    gap: 2.5rem;
  }
  .split-grid > * {
    min-width: 0;
  }
  @media (min-width: 900px) {
    .split-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 4rem;
    }
  }
  .col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.75rem;
  }
  .body {
    max-width: 36rem;
    font-size: 1.125rem;
    line-height: 1.55;
    color: rgb(35 44 84 / 0.85);
  }

  .screens {
    display: grid;
    gap: 3rem;
    margin-top: 3rem;
  }
  .screens > li {
    min-width: 0;
  }
  @media (min-width: 768px) {
    .screens {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2.5rem;
    }
  }
  .screen-frame {
    width: min(100%, 15rem);
  }
  .screen-body {
    max-width: 22rem;
    font-size: 1.0625rem;
    line-height: 1.5;
    color: rgb(35 44 84 / 0.85);
  }

  .rows {
    display: grid;
    gap: 1.5rem;
  }
  .rows > div {
    padding-top: 1.25rem;
    border-top: 1px solid rgb(255 255 255 / 0.18);
  }
  .rows-light > div {
    border-top-color: theme("colors.brand.line");
  }
  .rows dd {
    margin-top: 0.4rem;
    font-size: 1.125rem;
    line-height: 1.5;
  }
  .band-ink .rows dd {
    color: rgb(255 255 255 / 0.88);
  }
  .rows-light dd {
    color: rgb(35 44 84 / 0.88);
  }

  .studies {
    display: grid;
    gap: 1.5rem;
  }
  .studies a {
    font-size: 1.125rem;
  }
  .studies p {
    margin-top: 0.4rem;
    max-width: 36rem;
    font-size: 1.0625rem;
    line-height: 1.5;
    color: rgb(35 44 84 / 0.85);
  }
</style>
