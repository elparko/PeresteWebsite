---
import Base from "../../../layouts/Base.astro";
import "../../../styles/atlas-browse.css";

// Where the data lives. The public data repository is the default; set PUBLIC_ATLAS_DATA_URL at build time to
// serve it from elsewhere (for example a local static server during development).
const dataUrl = import.meta.env.PUBLIC_ATLAS_DATA_URL ?? "https://elparko.github.io/medication-neuron-atlas-data/";
// OVERVIEW LINK: set postUrl to the overview post's path (for example "/research/medication-neuron-atlas") once it is
// published. While it is null the page links nowhere and says the write-up will follow.
const postUrl: string | null = "/research/medication-neuron-atlas/";
---

<Base
  title="Medication neuron atlas: what an AI model attends to in drug labels · Pereste Health research"
  description="Browse the units of an AI language model that respond to FDA drug label text: dose numbers, units, frequencies, routes, interactions and more, with a written description for about 30,500 selected units and a score showing how far each can be trusted. Not guidance for patient care."
>
  <div class="ab-page">
    <header class="container-page ab-intro">
      <a href="/research" class="eyebrow ab-eyebrow">Research · Medication neuron atlas</a>
      <h1 class="ab-title">What does an AI model pay attention to in a drug label?</h1>
      <p class="ab-dek">
        Each entry is one unit of the language model Qwen3-8B, with where it fires in FDA drug labels and, for about
        30,500 units, a card describing it and how far to trust that card. Start with the featured units or search
        for a drug. The terms are defined below.
        {postUrl
          ? <>The <a href={postUrl}>overview</a> explains the method.</>
          : "A write-up of the method and findings will follow."}
      </p>
      <p class="ab-guidance">
        This page describes how an AI model reads text. It is not guidance for patient care and says nothing about
        any drug's effects.
      </p>
    </header>
    <div class="container-page">
      <div class="ab" data-atlas-browse data-base={dataUrl}>
        <noscript><p>The atlas browser needs JavaScript.</p></noscript>
      </div>
    </div>
  </div>
</Base>

<script src="../../../scripts/atlas-browse.js"></script>

<style>
  .ab-intro {
    display: grid;
    gap: 12px;
    padding-block: 3rem 2rem;
  }
  .ab-eyebrow:hover {
    color: #0f9ba8;
  }
  .ab-title {
    font-size: clamp(1.75rem, 1.2rem + 2.4vw, 2.6rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: #232c54;
    font-weight: 700;
    margin: 0;
  }
  .ab-dek {
    max-width: 68ch;
    margin: 0;
    font-size: 1.02rem;
    color: #2f3857;
  }
  .ab-dek a {
    color: #0b6f78;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .ab-guidance {
    max-width: 68ch;
    margin: 0;
    font-size: 0.86rem;
    color: #5a6472;
    border-left: 3px solid #cdd5e0;
    padding-left: 12px;
  }
</style>
