---
import Base from "../../layouts/Base.astro";
import Hero from "../../components/Hero.astro";
import Section from "../../components/Section.astro";
import { getPublishedPosts, formatDate } from "../../data/posts";

const papers = [
  {
    href: "/research/dosegate",
    title:
      "A model-agnostic, formally verified output layer that keeps language model medication instructions faithful to medication orders",
    description:
      "A Lean 4 output layer that fills every medication reference in a language model's instructions from the patient's medication orders or blocks the output.",
    date: new Date("2026-11-05"),
    tag: "Paper",
    draft: false,
  },
];

const posts = [
  ...(await getPublishedPosts()).map((post) => ({ href: `/research/${post.id}`, ...post.data })),
  ...papers,
].sort((a, b) => b.date.valueOf() - a.date.valueOf());
---

<Base
  title="Research · Pereste"
  description="Papers and studies from Pereste Health on building safe, plain-language healthcare AI."
>
  <Hero
    eyebrow="Research"
    title="Research from Pereste."
    lede="Papers and studies on building healthcare AI that explains medicine to patients in plain words without giving medical advice or misstating an order."
  />

  <Section bordered>
    {posts.length === 0 ? (
      <p class="text-brand-muted">No posts yet.</p>
    ) : (
      <ul class="grid gap-6" data-reveal>
        {posts.map((post) => (
          <li>
            <a href={post.href} class="card block p-7 md:p-9">
              <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-brand-muted">
                <span class="eyebrow text-brand-accent">{post.tag}</span>
                <time datetime={post.date.toISOString()}>{formatDate(post.date)}</time>
                {post.draft && <span class="eyebrow text-brand-indigo">Draft</span>}
              </div>
              <h3 class="mt-4 max-w-3xl">{post.title}</h3>
              <p class="mt-3 max-w-prose text-brand-ink/80">{post.description}</p>
              <span class="link-arrow mt-6">Read</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </Section>
</Base>
