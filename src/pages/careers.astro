---
import Base from "../layouts/Base.astro";
import PageOpening from "../components/PageOpening.astro";
---

<Base
  title="Careers · Pereste Health"
  description="Pereste Health has no open roles listed right now. Clinicians, engineers and researchers who want to work on Pereste Guide or on safety research for healthcare AI may write to us."
>
  <PageOpening label="Careers" title="Careers at Pereste Health.">
    <p>
      Pereste Health has no open roles listed right now. Clinicians, engineers and researchers who want
      to work on Pereste Guide or on safety research for healthcare AI may write to parker@pereste.com.
    </p>
    <a slot="links" href="mailto:parker@pereste.com" class="btn-primary">parker@pereste.com</a>
  </PageOpening>

  <section class="careers-band hairline">
    <div class="container-page">
      <div class="careers-grid">
        <div>
          <p class="label-mono mb-4">Where the work is</p>
          <h2>Two lines of work.</h2>
        </div>
        <ul class="areas">
          <li>
            <p class="label-mono">Guide</p>
            <p>A voice app that explains a patient's own health record in plain language.</p>
            <a href="/guide/" class="link-arrow">See Guide</a>
          </li>
          <li>
            <p class="label-mono">Research</p>
            <p>Safety research on the AI models used in healthcare.</p>
            <a href="/research/" class="link-arrow">Read the research</a>
          </li>
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .careers-band {
    padding-block: clamp(3.5rem, 2.5rem + 4vw, 6rem);
  }
  .careers-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
  }
  .careers-grid > :global(*) {
    min-width: 0;
  }
  .careers-grid h2 {
    max-width: 18ch;
  }
  .areas {
    display: grid;
    gap: 1.5rem;
  }
  .areas li {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
    padding-top: 1.25rem;
    border-top: 1px solid theme("colors.brand.line");
  }
  .areas li p:not(.label-mono) {
    font-size: 1.0625rem;
    line-height: 1.55;
    color: rgb(35 44 84 / 0.88);
  }
  @media (min-width: 640px) {
    .areas {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem;
    }
  }
  @media (min-width: 900px) {
    .careers-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 4rem;
    }
  }
</style>
