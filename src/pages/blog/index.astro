---
import Base from "../../layouts/Base.astro";
import Hero from "../../components/Hero.astro";
import Section from "../../components/Section.astro";
import { getPublishedPosts, formatDate } from "../../data/posts";

const posts = await getPublishedPosts();
---

<Base
  title="Blog · Pereste"
  description="Research notes and updates from Pereste Health on building safe, plain-language healthcare AI."
>
  <Hero
    eyebrow="Blog"
    title="Research and notes from Pereste."
    lede="What we are learning while building healthcare AI that explains a patient's own records in plain words."
  />

  <Section bordered>
    {posts.length === 0 ? (
      <p class="text-brand-muted">No posts yet.</p>
    ) : (
      <ul class="grid gap-6" data-reveal>
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}`} class="card block p-7 md:p-9">
              <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-brand-muted">
                <span class="eyebrow text-brand-accent">{post.data.tag}</span>
                <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                {post.data.draft && <span class="eyebrow text-brand-indigo">Draft</span>}
              </div>
              <h3 class="mt-4 max-w-3xl">{post.data.title}</h3>
              <p class="mt-3 max-w-prose text-brand-ink/80">{post.data.description}</p>
              <span class="link-arrow mt-6">Read</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </Section>
</Base>
