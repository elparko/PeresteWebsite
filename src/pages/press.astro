---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import ConditionChips from "../components/ConditionChips.astro";

const snapshot = [
  { label: "Legal name", value: "Pereste Health Inc." },
  { label: "Headquarters", value: "Louisiana, USA" },
  { label: "Sector", value: "Healthcare AI" },
  { label: "Product", value: "HearthAI", href: "/hearthai" },
  { label: "Conditions covered", value: "Six chronic conditions" },
  { label: "Deployment", value: "On-premises, inside partner institutions" },
  { label: "Press contact", value: "parker@pereste.com", href: "mailto:parker@pereste.com" },
];

const assets = [
  { src: "/logos/logo-primary.png", label: "Primary logo", dark: false },
  { src: "/logos/logo-black.png", label: "Wordmark — black", dark: false },
  { src: "/logos/logo-white.png", label: "Wordmark — white", dark: true },
  { src: "/logos/mark-square.png", label: "App mark", dark: false },
];
---

<Base
  title="Press — Pereste"
  description="Press inquiries, company information, and brand assets for Pereste Health Inc."
>
  <Hero
    eyebrow="Press"
    title="Press and media inquiries."
    lede="Pereste Health Inc. is a Louisiana-based healthcare AI company building and deploying clinical AI in partnership with institutions — now across six chronic conditions. For interviews, briefings, or background, reach out."
    primaryCta={{ href: "mailto:parker@pereste.com", label: "Press inquiries" }}
  />

  {/* Media contact */}
  <Section bordered>
    <div class="grid md:grid-cols-12 gap-10 items-start">
      <div class="md:col-span-4">
        <p class="eyebrow">Media contact</p>
      </div>
      <div class="md:col-span-8">
        <p class="lede">
          For interviews, briefings, fact-checks, or background, contact Parker
          directly. We aim to respond to press within one business day.
        </p>
        <div class="mt-6">
          <a href="mailto:parker@pereste.com" class="btn-primary">parker@pereste.com</a>
        </div>
      </div>
    </div>
  </Section>

  {/* Company snapshot */}
  <Section bordered>
    <div class="grid md:grid-cols-12 gap-10">
      <div class="md:col-span-4">
        <p class="eyebrow">Company snapshot</p>
      </div>
      <div class="md:col-span-8">
        <ul class="divide-y divide-brand-line">
          {snapshot.map((row) => (
            <li class="py-4 flex justify-between gap-6 text-sm md:text-base">
              <span class="text-brand-muted">{row.label}</span>
              <span class="text-brand-ink text-right">
                {row.href ? (
                  <a href={row.href} class="link-arrow">{row.value}</a>
                ) : (
                  row.value
                )}
              </span>
            </li>
          ))}
        </ul>
        <div class="mt-8">
          <p class="eyebrow mb-4">Conditions HearthAI supports</p>
          <ConditionChips />
        </div>
      </div>
    </div>
  </Section>

  {/* About Pereste — reusable boilerplate */}
  <Section tone="subtle">
    <div class="flex items-center justify-between gap-6 mb-4">
      <p class="eyebrow">About Pereste</p>
      <p class="text-xs text-brand-muted">Standard description — copy freely</p>
    </div>
    <p class="lede max-w-3xl">
      Pereste Health Inc. is a Louisiana-based healthcare AI company building and
      deploying clinical AI in partnership with the institutions that already
      serve underserved patients. Its product, HearthAI, is an adaptive,
      voice-based companion that turns complex discharge and care-plan
      information into a spoken conversation at each patient's own reading level
      — currently across six chronic conditions: chronic kidney disease, type 2
      diabetes, COPD, heart failure, obesity, and hypertension. Pereste runs
      on-premises inside partner institutions, with no PHI egress.
    </p>
  </Section>

  {/* Brand assets */}
  <Section bordered>
    <p class="eyebrow mb-4">Brand assets</p>
    <h2 class="max-w-3xl mb-3">Logos and marks.</h2>
    <p class="lede max-w-2xl mb-12">
      Please use the assets below as provided, without modifying the lockup,
      color, or proportions. For other formats, just ask.
    </p>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {assets.map((asset) => (
        <div class="rounded-2xl border border-brand-line overflow-hidden">
          <div
            class={`h-32 flex items-center justify-center p-6 ${
              asset.dark ? "bg-brand-ink" : "bg-brand-subtle"
            }`}
          >
            <img
              src={asset.src}
              alt={asset.label}
              class="max-h-full max-w-full w-auto object-contain"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="flex items-center justify-between gap-3 px-4 py-3">
            <span class="text-sm text-brand-ink">{asset.label}</span>
            <a
              href={asset.src}
              download
              class="text-xs font-medium text-brand-muted hover:text-brand-ink"
            >
              Download
            </a>
          </div>
        </div>
      ))}
    </div>
  </Section>
</Base>
