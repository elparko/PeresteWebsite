---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import ConditionChips from "../components/ConditionChips.astro";

const snapshot = [
  { label: "Legal name", value: "Pereste Health Inc." },
  { label: "Headquarters", value: "Louisiana, USA" },
  { label: "Sector", value: "Healthcare AI" },
  { label: "Product", value: "Guide", href: "/guide" },
  { label: "Conditions covered", value: "Six chronic conditions" },
  { label: "Deployment", value: "On-premises, inside partner institutions" },
  { label: "Press contact", value: "parker@pereste.com", href: "mailto:parker@pereste.com" },
];
---

<Base
  title="Press · Pereste"
  description="Press inquiries and company information for Pereste Health Inc."
>
  <Hero
    eyebrow="Press"
    title="Press and media inquiries."
    lede="Pereste Health Inc. is a Louisiana-based healthcare AI company building and deploying clinical AI in partnership with institutions, now across six chronic conditions. For interviews, briefings, or background, reach out."
    primaryCta={{ href: "mailto:parker@pereste.com", label: "Press inquiries" }}
  />

  {/* Media contact */}
  <Section bordered>
    <div class="grid md:grid-cols-12 gap-10 items-start">
      <div class="md:col-span-4">
        <p class="eyebrow">Media contact</p>
      </div>
      <div class="md:col-span-8">
        <p class="lede">
          For interviews, briefings, fact-checks, or background, contact Parker
          directly. We aim to respond to press within one business day.
        </p>
        <div class="mt-6">
          <a href="mailto:parker@pereste.com" class="btn-primary">parker@pereste.com</a>
        </div>
      </div>
    </div>
  </Section>

  {/* Company snapshot */}
  <Section bordered>
    <div class="grid md:grid-cols-12 gap-10">
      <div class="md:col-span-4">
        <p class="eyebrow">Company snapshot</p>
      </div>
      <div class="md:col-span-8">
        <ul class="divide-y divide-brand-line">
          {snapshot.map((row) => (
            <li class="py-4 flex justify-between gap-6 text-sm md:text-base">
              <span class="text-brand-muted">{row.label}</span>
              <span class="text-brand-ink text-right">
                {row.href ? (
                  <a href={row.href} class="link-arrow">{row.value}</a>
                ) : (
                  row.value
                )}
              </span>
            </li>
          ))}
        </ul>
        <div class="mt-8">
          <p class="eyebrow mb-4">Conditions Guide covers</p>
          <ConditionChips />
        </div>
      </div>
    </div>
  </Section>

  {/* About Pereste — reusable boilerplate */}
  <Section tone="subtle">
    <div class="flex items-center justify-between gap-6 mb-4">
      <p class="eyebrow">About Pereste</p>
      <p class="text-xs text-brand-muted">Standard description, copy freely</p>
    </div>
    <p class="lede max-w-3xl">
      Pereste Health Inc. is a Louisiana-based healthcare AI company building and
      deploying clinical AI in partnership with the institutions that already
      serve underserved patients. Its product, Guide, is an adaptive, voice-first
      companion that turns a patient's own records, lab results, and care plan
      into a spoken conversation at their reading level, currently across six
      chronic conditions: type 2 diabetes, heart failure, chronic kidney disease,
      COPD, high blood pressure, and obesity. Guide runs on-premises inside
      partner institutions, with no patient data sent to outside AI services.
    </p>
  </Section>

</Base>
