---
import Base from "../layouts/Base.astro";
import PageOpening from "../components/PageOpening.astro";
import ConditionChips from "../components/ConditionChips.astro";
import { researchItems } from "../data/researchItems";

const logos = [
  { href: "/logos/logo-primary.png", label: "Logo, color" },
  { href: "/logos/logo-black.png", label: "Logo, black" },
  { href: "/logos/logo-white.png", label: "Logo, white" },
  { href: "/logos/pereste-mark.svg", label: "Mark, SVG" },
  { href: "/logos/pereste-mark-inverse.svg", label: "Mark, inverse SVG" },
];
---

<Base
  title="Press · Pereste Health"
  description="Press contact and company facts for Pereste Health Inc., the maker of Pereste Guide and a publisher of safety research on the AI models used in healthcare."
>
  <PageOpening label="Press" title="Press and media inquiries.">
    <p>For interviews, briefings or background, write to parker@pereste.com.</p>
    <a slot="links" href="mailto:parker@pereste.com" class="btn-primary">parker@pereste.com</a>
  </PageOpening>

  <section class="press-band hairline">
    <div class="container-page">
      <div class="press-grid">
        <h2 class="label-mono">Company facts</h2>
        <dl class="facts">
          <div class="row">
            <dt class="label-mono">Legal name</dt>
            <dd>Pereste Health Inc.</dd>
          </div>
          <div class="row">
            <dt class="label-mono">Based in</dt>
            <dd>Louisiana, USA</dd>
          </div>
          <div class="row">
            <dt class="label-mono">Pereste Guide</dt>
            <dd>
              <p>
                Pereste Guide is a voice app that reads a patient's own discharge papers, lab results and care plan and
                explains them out loud in plain language. It does not give medical advice, and it sends
                the patient to a person when something sounds urgent.
              </p>
              <div class="chips"><ConditionChips /></div>
              <a href="/guide/" class="link-arrow mt-5">See Guide</a>
            </dd>
          </div>
          <div class="row">
            <dt class="label-mono">Research</dt>
            <dd>
              <ul class="research-list">
                {researchItems.map((r) => (
                  <li>
                    <a href={r.href} class="link-arrow">{r.title}</a>
                    <span class="label-mono models">{r.models}</span>
                  </li>
                ))}
              </ul>
              <a href="/research/" class="link-arrow mt-5">All research</a>
            </dd>
          </div>
          <div class="row">
            <dt class="label-mono">Stage</dt>
            <dd>Pereste Guide is in development and is not yet in use with patients. It is planned for the App Store and Google Play.</dd>
          </div>
          <div class="row">
            <dt class="label-mono">Press contact</dt>
            <dd><a href="mailto:parker@pereste.com" class="link-arrow">parker@pereste.com</a></dd>
          </div>
          <div class="row">
            <dt class="label-mono">Logos</dt>
            <dd>
              <ul class="logo-list">
                {logos.map((l) => (
                  <li><a href={l.href} class="link-arrow" download>{l.label}</a></li>
                ))}
              </ul>
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="press-band boiler">
    <div class="container-page">
      <div class="press-grid">
        <div>
          <h2 class="label-mono">Standard description</h2>
          <p class="note">Copy freely.</p>
        </div>
        <p class="boiler-text">
          Pereste Health Inc. is a Louisiana company with two lines of work. It builds Pereste Guide, a voice app
          in development that explains a patient's own records in plain language across six chronic conditions (type 2
          diabetes, heart failure, chronic kidney disease, COPD, high blood pressure and obesity), for
          rural and underserved care. It also publishes safety research on the language models used in
          healthcare.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .press-band {
    padding-block: clamp(3.5rem, 2.5rem + 4vw, 6rem);
  }
  .boiler {
    background: theme("colors.brand.subtle");
  }
  .press-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
  }
  .press-grid > :global(*) {
    min-width: 0;
  }
  .facts {
    display: grid;
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.5rem;
    padding-block: 1.25rem;
    border-top: 1px solid theme("colors.brand.line");
  }
  .row:last-child {
    border-bottom: 1px solid theme("colors.brand.line");
  }
  .row dt {
    padding-top: 0.2rem;
  }
  .row dd {
    min-width: 0;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: rgb(35 44 84 / 0.88);
    overflow-wrap: anywhere;
  }
  .chips {
    margin-top: 1.25rem;
  }
  .research-list,
  .logo-list {
    display: grid;
    gap: 0.9rem;
  }
  .research-list li {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .models {
    line-height: 1.5;
  }
  .note {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: theme("colors.brand.muted");
  }
  .boiler-text {
    max-width: 44rem;
    font-size: clamp(1.05rem, 1rem + 0.3vw, 1.25rem);
    line-height: 1.6;
    color: theme("colors.brand.ink");
  }
  @media (min-width: 640px) {
    .row {
      grid-template-columns: minmax(0, 11rem) minmax(0, 1fr);
      gap: 2rem;
    }
  }
  @media (min-width: 900px) {
    .press-grid {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      gap: 4rem;
    }
  }
</style>
