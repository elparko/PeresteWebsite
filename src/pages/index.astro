---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import Card from "../components/Card.astro";
import CTA from "../components/CTA.astro";
import ConditionChips from "../components/ConditionChips.astro";

const stats = [
  {
    figure: "~90M",
    body: "Americans have literacy skills insufficient for today's healthcare settings.",
    source: "JAMA",
  },
  {
    figure: "59%",
    body: "of adults 65+ have basic or below-basic health literacy, so how care gets explained decides whether it lands.",
    source: "AHA Scientific Statement",
  },
  {
    figure: "Worse",
    body: "control, more ER visits, and more deaths follow low health literacy across chronic disease.",
    source: "AHA / NIH",
  },
];
---

<Base
  title="Pereste Health: Better understanding, better outcomes."
  description="Pereste Health builds Guide: AI-powered chronic-disease education and support in plain language, grounded in each patient's own records and HIPAA-secured, built for rural and underserved care across six chronic conditions."
>
  <Hero
    eyebrow="Pereste Health"
    title="Healthcare AI that meets patients where they are."
    lede="Pereste builds Guide: AI-powered chronic-disease education and support that speaks in plain language, grounded in each patient's own records, and built for the realities of rural and underserved care."
    primaryCta={{ href: "/guide", label: "Meet Guide" }}
    secondaryCta={{ href: "/about", label: "About Pereste" }}
    image={{ src: "/images/app-home.png", alt: "Guide app home screen on a phone" }}
  />

  {/* Mission band */}
  <Section bordered>
    <div class="grid md:grid-cols-12 gap-10">
      <div class="md:col-span-4">
        <p class="eyebrow">Mission</p>
      </div>
      <div class="md:col-span-8">
        <p class="text-2xl md:text-3xl font-display font-semibold tracking-tight-2 leading-snug text-brand-ink">
          We build clinical AI for the patients health systems struggle most to
          reach, and deploy it inside the institutions that already care for
          them.
        </p>
        <p class="lede mt-6">
          Prevention and chronic-disease management, delivered as close to the
          patient's home as the clinic itself: privacy-preserving, grounded in
          clinical reality, and shaped by how patients actually experience their
          care.
        </p>
      </div>
    </div>
  </Section>

  {/* The literacy gap — public, cited research */}
  <Section tone="subtle">
    <p class="eyebrow mb-4">The literacy gap</p>
    <h2 class="max-w-3xl mb-12">
      Who gets left behind by today's healthcare communication.
    </h2>
    <div class="grid md:grid-cols-3 gap-6">
      {stats.map((s) => (
        <div class="rounded-2xl border border-brand-line bg-brand-surface p-7 flex flex-col">
          <p class="font-display text-4xl md:text-5xl font-bold tracking-tight-2 text-brand-ink">
            {s.figure}
          </p>
          <p class="mt-4 text-brand-ink/80 leading-relaxed flex-1">{s.body}</p>
          <p class="mt-6 text-xs uppercase tracking-[0.14em] text-brand-muted">
            {s.source}
          </p>
        </div>
      ))}
    </div>
  </Section>

  {/* Approach — the three commitments */}
  <Section bordered>
    <p class="eyebrow mb-4">Our approach</p>
    <h2 class="max-w-3xl mb-12">
      Built for the patients the health system struggles most to reach.
    </h2>
    <div class="grid md:grid-cols-3 gap-6">
      <Card
        eyebrow="01"
        title="Built for clinical reality"
        icon={{ src: "/images/icon-models.svg", alt: "" }}
      >
        Adaptive to each patient, grounded in their own clinical record, and
        designed to behave safely when the stakes are real, not a generic
        chatbot pointed at health questions.
      </Card>
      <Card
        eyebrow="02"
        title="Deployed in partnership"
        icon={{ src: "/images/icon-partnership.svg", alt: "" }}
      >
        Guide runs under the institution's existing governance and security,
        delivered with health systems and academic partners, never
        direct-to-consumer.
      </Card>
      <Card
        eyebrow="03"
        title="Rural-first by design"
        icon={{ src: "/images/icon-rural.svg", alt: "" }}
      >
        We design for an aging, rural population managing chronic conditions,
        where comprehension, pace, and trust decide whether care actually works.
        Get it right for them, and it works for everyone.
      </Card>
    </div>
  </Section>

  {/* Product — Guide */}
  <Section bordered>
    <div class="grid md:grid-cols-12 gap-10 items-start">
      <div class="md:col-span-4">
        <p class="eyebrow">Our product</p>
        <h2 class="mt-4">Guide</h2>
      </div>
      <div class="md:col-span-8">
        <p class="lede">
          Guide turns dense discharge papers, lab results, and care plans into a
          calm, spoken conversation at each patient's own reading level. And it
          knows which symptoms are urgent and need a real person, fast. It
          covers six of the most common chronic conditions:
        </p>
        <div class="mt-6">
          <ConditionChips />
        </div>
        <div class="mt-8">
          <a href="/guide" class="link-arrow">See how Guide works</a>
        </div>
      </div>
    </div>
  </Section>

  {/* Audience CTAs */}
  <Section>
    <div class="grid md:grid-cols-2 gap-6">
      <CTA
        eyebrow="For institutions"
        title="Deploy Guide inside the systems that already care for your patients."
        body="We partner with clinics, health systems, and academic care settings to run Guide under the governance and security they already trust, with no patient data sent to outside AI services."
        primaryCta={{ href: "mailto:parker@pereste.com", label: "Talk to our team" }}
        tone="ink"
      />
      <CTA
        eyebrow="For investors"
        title="Durable IP at the intersection of clinical AI and underserved care."
        body="Pereste holds the methods and proprietary IP behind Guide, built for an aging, rural population. Investor and partnership inquiries welcome."
        primaryCta={{ href: "mailto:parker@pereste.com", label: "Request our overview" }}
        tone="subtle"
      />
    </div>
  </Section>
</Base>
